+    [Fact]
+    public void Bounded_history_rejects_invalid_inputs_and_identity_binds_order_and_repeats()
+    {
+        Assert.Throws<ArgumentException>(() => new DialogueConversationContext(ValueList<string>.From(Enumerable.Repeat("x", 33)), "q"));
+        Assert.Throws<ArgumentException>(() => new DialogueConversationContext(ValueList<string>.From([new string('x', 513)]), "q"));
+        Assert.Throws<ArgumentException>(() => new DialogueConversationContext(null, new string('x', 513)));
+        Assert.Throws<ArgumentException>(() => new DialogueConversationContext(ValueList<string>.From([null!]), "q"));
+        var r = Request();
+        var a = Copy(r, new(ValueList<string>.From(["A: one", "B: two"]), "q"));
+        var b = Copy(r, new(ValueList<string>.From(["B: two", "A: one"]), "q"));
+        var c = Copy(r, new(ValueList<string>.From(["A: one", "B: two", "B: two"]), "q"));
+        Assert.NotEqual(a.RequestId, b.RequestId);
+        Assert.NotEqual(a.RequestId, c.RequestId);
+        Assert.Equal(a.RequestId, Copy(a, a.ConversationContext).RequestId);
+    }
