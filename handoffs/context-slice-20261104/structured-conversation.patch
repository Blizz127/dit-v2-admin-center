+    private static DialogueWordingRequest Request(string game = "ffxi", bool rewrite = false, string? games = "ffxi,swtor",
+        IReadOnlyList<string>? history = null, string current = "What happened at that entrance?")
+    {
+        using var store = new NeuronetworkStore(":memory:");
+        var service = Service(store, new Capture(), games);
+        var line = new CompanionLine
+        {
+            GameId = game, ServerInstanceId = "synthetic-realm", Persona = "Fixture", Speaker = "Player", SpeakerIsOwner = true,
+            Text = current, Channel = game == "ffxi" ? "linkshell" : "party", History = history ?? Exchange,
+            Facts = [new("knowledge_lookup_ref1", "Synthetic reference for prompt construction only"),
+                new("live_state", "Synthetic idle observation"), new("world_fixture", "Synthetic world context")],
+            Bot = new ConversationHearer { ActorKey = "fixture", DisplayName = "Fixture" },
+        };
+        return (DialogueWordingRequest)typeof(ConversationService).GetMethod("CompanionRequest", BindingFlags.NonPublic | BindingFlags.Instance)!
+            .Invoke(service, [line, new ConversationContext.Actor("fixture", "Fixture", "casual", "brief", game),
+                Array.Empty<string>(), Now, rewrite ? "fixture unsupported location" : null])!;
+    }
