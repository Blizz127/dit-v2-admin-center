+            var retained = input.ConversationContext!.History.TakeLast(16).ToArray();
+            Assert.Equal(retained, request.ConversationContext!.History);
+            Assert.Equal(input.ConversationContext.CurrentMessage, request.ConversationContext.CurrentMessage);
+            var prompt = DialogueWordingPromptText.Build(request);
