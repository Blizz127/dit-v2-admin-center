@@ -0,0 +1,116 @@
+using System.Net;
+using System.Text;
+using System.Text.Json;
+using Dit.HumanBehavior.Contracts;
+using Dit.HumanBehavior.DialogueWording;
+using Dit.HumanBehavior.Neuronetwork.Client;
+using Xunit;
+
+namespace Dit.HumanBehavior.Neuronetwork.Tests;
+
+[Collection("Producer context environment")]
+public sealed class ConversationProducerContextTests
+{
+    private sealed class Capture : HttpMessageHandler
+    {
+        public List<(string Path, string Body)> Calls = [];
+        protected override async Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken ct)
+        {
+            Calls.Add((request.RequestUri!.AbsolutePath, await request.Content!.ReadAsStringAsync(ct)));
+            var response = request.RequestUri.AbsolutePath.EndsWith("/event")
+                ? "{\"actorKey\":\"fixture\",\"kind\":\"idle\",\"text\":null,\"note\":\"fixture\"}"
+                : "{\"lineId\":\"synthetic\",\"mode\":\"live\",\"decisions\":[],\"notes\":[]}";
+            return new(HttpStatusCode.OK) { Content = new StringContent(response, Encoding.UTF8, "application/json") };
+        }
+    }
+    private static DialogueWordingRequest Request(string game, int turns, bool current, bool context = true)
+    {
+        var now = DateTimeOffset.UtcNow;
+        var history = Enumerable.Range(0, turns).Select(n => n is 4 or 5 ? "Fixture: repeated on purpose" : "Fixture: turn " + n).ToArray();
+        var trigger = Enumerable.Range(0, 12).Select(n => new DialogueContextFact("untrusted_conversation_history_" + n, "Legacy: " + n)).ToList();
+        trigger.Add(new("untrusted_player_message", "Legacy current message"));
+        return new("synthetic-intent", new(game, "fixture-instance", GameEnvironment.IsolatedTest),
+            new(ActorIdentityKind.GameNativeActor, "player_bot", "fixture", null, "Fixture"), "social_nearby", "Say something brief",
+            "fixture.turn", ValueList<DialogueContextFact>.From(trigger), "tell", "single_player", "Friendly", "Brief", null,
+            "stranger", "Synthetic conversation", "unknown", null, 100, 200, "en-US", "fixture-v1", "neuronet_conversation", "...",
+            DialogueFallbackPolicy.Silence, new DialogueOutputConstraints(), now, now.AddSeconds(30), "synthetic",
+            conversationContext: context ? new(ValueList<string>.From(history), current ? "Structured current message" : null) : null);
+    }
+
+    private static async Task<(string Path, JsonElement Body, List<string> Reports)> Forward(string game, string path,
+        string? flag, int turns = 12, bool context = true)
+    {
+        using var temp = new TempDirectory();
+        var env = new Dictionary<string, string?>
+        {
+            ["DIT_NEURONETWORK_CONSULT_TOKEN_DIRECTORY"] = temp.Path,
+            ["DIT_" + game.ToUpperInvariant() + "_HUB_CONVERSATION"] = "only",
+            ["DIT_" + game.ToUpperInvariant() + "_GROUP"] = path == "group" ? "live" : "off",
+            ["DIT_" + game.ToUpperInvariant() + "_GROUP_ACTORS"] = "",
+        };
+        var before = env.Keys.ToDictionary(k => k, Environment.GetEnvironmentVariable);
+        try
+        {
+            foreach (var (key, value) in env) Environment.SetEnvironmentVariable(key, value);
+            File.WriteAllText(Path.Combine(temp.Path, game + ".token"), "synthetic-token");
+            var handler = new Capture(); using var http = new HttpClient(handler);
+            var hub = new NeuronetConversationClient(game, http, "http://fixture.invalid");
+            var reports = new List<string>();
+            using var provider = NeuronetConversationWordingProvider.HubOnly(hub, "fixture-instance", reports.Add);
+            provider.ContextEnvironment = _ => flag;
+            await provider.GenerateAsync(Request(game, turns, path != "event", context), default);
+            var call = Assert.Single(handler.Calls);
+            using var parsed = JsonDocument.Parse(call.Body);
+            return (call.Path, parsed.RootElement.Clone(), reports);
+        }
+        finally { foreach (var (key, value) in before) Environment.SetEnvironmentVariable(key, value); }
+    }
+
+    [Theory]
+    [InlineData("ffxi", "reply")] [InlineData("ffxi", "group")] [InlineData("ffxi", "event")]
+    [InlineData("swtor", "reply")] [InlineData("swtor", "group")] [InlineData("swtor", "event")]
+    public async Task Actual_client_forwards_structured_turns_and_current_message(string game, string path)
+    {
+        var result = await Forward(game, path, " FFXI,swtor ");
+        Assert.EndsWith("/conversation/" + path, result.Path);
+        var history = result.Body.GetProperty(path == "event" ? "recentLines" : "history").EnumerateArray().Select(v => v.GetString()).ToArray();
+        Assert.Equal(12, history.Length);
+        Assert.Equal("Fixture: turn 0", history[0]); Assert.Equal("Fixture: turn 11", history[^1]);
+        Assert.Equal(history[4], history[5]);
+        Assert.DoesNotContain(history, v => v!.StartsWith("Legacy:"));
+        if (path != "event") Assert.Equal("Structured current message", result.Body.GetProperty("text").GetString());
+        Assert.Contains(result.Reports, r => r.Contains("history supplied=12, prepared=12, omitted=0"));
+    }
+
+    [Theory]
+    [InlineData("ffxi")] [InlineData("swtor")]
+    public async Task Existing_wire_cap_keeps_newest_whole_turns_and_reports_omission(string game)
+    {
+        var result = await Forward(game, "group", game, 32);
+        var history = result.Body.GetProperty("history").EnumerateArray().Select(v => v.GetString()).ToArray();
+        Assert.Equal(16, history.Length); Assert.Equal("Fixture: turn 16", history[0]); Assert.Equal("Fixture: turn 31", history[^1]);
+        Assert.Contains(result.Reports, r => r.Contains("history supplied=32, prepared=16, omitted=16"));
+    }
+
+    [Theory]
+    [InlineData(null)] [InlineData("")] [InlineData("ffxi_extra")] [InlineData("swtor")]
+    public async Task Default_off_and_unselected_game_preserve_legacy_behavior(string? flag)
+    {
+        var result = await Forward("ffxi", "reply", flag);
+        Assert.Equal("Legacy current message", result.Body.GetProperty("text").GetString());
+        Assert.Equal(8, result.Body.GetProperty("history").GetArrayLength());
+        Assert.Equal("Legacy: 0", result.Body.GetProperty("history")[0].GetString());
+        Assert.DoesNotContain(result.Reports, r => r.StartsWith("hub-context"));
+    }
+
+    [Fact]
+    public async Task Selected_game_without_structured_context_retains_legacy_input()
+    {
+        var result = await Forward("ffxi", "reply", "ffxi", context: false);
+        Assert.Equal("Legacy current message", result.Body.GetProperty("text").GetString());
+        Assert.Equal(8, result.Body.GetProperty("history").GetArrayLength());
+    }
+}
+
+[CollectionDefinition("Producer context environment", DisableParallelization = true)]
+public sealed class ProducerContextEnvironmentCollection { }
