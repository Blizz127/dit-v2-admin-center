diff --git a/src/Dit.HumanBehavior.Neuronetwork/Conversation/FfxiConversationStatusSource.cs b/src/Dit.HumanBehavior.Neuronetwork/Conversation/FfxiConversationStatusSource.cs
new file mode 100644
index 0000000..371d817
--- /dev/null
+++ b/src/Dit.HumanBehavior.Neuronetwork/Conversation/FfxiConversationStatusSource.cs
@@ -0,0 +1,72 @@
+using System.Globalization;
+using Dit.HumanBehavior.Contracts;
+using Dit.HumanBehavior.DialogueWording;
+using Dit.HumanBehavior.Neuronetwork.Interaction;
+
+namespace Dit.HumanBehavior.Neuronetwork.Conversation;
+
+/// <summary>
+/// Reads the real ordered interaction store without ingesting or dispatching.
+/// The v1 producer does not attest presence: even a fresh snapshot therefore
+/// cannot make the projected body facts known. Do not infer online from a zone,
+/// a chat line, or a freshly received action report. Native evidence is required.
+/// </summary>
+public sealed class FfxiConversationStatusSource : IConversationStatusSource
+{
+    private readonly FfxiInteraction _interaction;
+    private readonly IReadOnlyDictionary<(InteractionScope Scope, string Actor), StatusBodyIdentity> _bodies;
+    private readonly Func<string, string?> _environment;
+    private readonly ConversationStatusPolicy _policy;
+    private const string Source = "ffxi-interaction-v1";
+
+    public FfxiConversationStatusSource(FfxiInteraction interaction,
+        IReadOnlyDictionary<(InteractionScope Scope, string Actor), StatusBodyIdentity> bodies,
+        Func<string, string?> environment)
+    {
+        if (bodies.Count > 5000) throw new ArgumentException("Native identity registry exceeds its bound.");
+        foreach (var (key, body) in bodies)
+            if (key.Scope.GameId != FfxiInteraction.GameId || body.Game != key.Scope.GameId ||
+                body.Instance != key.Scope.ServerInstanceId ||
+                new[] { key.Scope.Caller, key.Scope.ServerInstanceId, key.Actor, body.Realm, body.NativeActorId }
+                    .Any(v => string.IsNullOrWhiteSpace(v) || v.Length > 128 || v.Any(char.IsControl)))
+                throw new ArgumentException("Native identity registry has an invalid binding.");
+        _interaction = interaction;
+        _bodies = new Dictionary<(InteractionScope, string), StatusBodyIdentity>(bodies);
+        _environment = environment;
+        _policy = new(Source, "ffxi-interaction-v1-" + interaction.States.FreshFor.Ticks.ToString(CultureInfo.InvariantCulture),
+            Enum.GetValues<StatusField>().ToDictionary(f => f, _ => interaction.States.FreshFor));
+    }
+
+    public ConversationStatusCapture? Capture(ConversationStatusLookup lookup)
+    {
+        if (!FfxiInteraction.On(_environment, FfxiInteraction.ContractFlag) || lookup.Game != FfxiInteraction.GameId ||
+            lookup.NativeScope is not { } scope || scope.GameId != lookup.Game || scope.ServerInstanceId != lookup.ServerInstance ||
+            !_bodies.TryGetValue((scope, lookup.ActorKey), out var body) ||
+            _interaction.ConversationSnapshot(scope, lookup.ActorKey) is not { } read)
+            return null;
+
+        var native = read.Snapshot;
+        var at = native.ObservedAtUtc;
+        // Never turn malformed/future producer clocks into a fresh read-time timestamp.
+        if (at.Offset != TimeSpan.Zero || at > read.ReceivedAt || at > DateTimeOffset.MaxValue - _interaction.States.FreshFor)
+            return null;
+        var until = at + _interaction.States.FreshFor;
+        var activity = FfxiInteraction.ActivityOf(native);
+        var fields = new List<StatusFieldObservation>();
+        void Add(StatusField field, string? value)
+        {
+            if (!string.IsNullOrWhiteSpace(value)) fields.Add(new(field, value, at, until));
+        }
+        Add(StatusField.Location, native.Zone);
+        Add(StatusField.Activity, activity == FfxiSelfClaims.Activity.Unknown ? null : activity.ToString().ToLowerInvariant());
+        Add(StatusField.Party, native.PartyKey);
+        Add(StatusField.Job, native.Job);
+        Add(StatusField.Level, native.Level?.ToString(CultureInfo.InvariantCulture));
+        // No presence field exists in v1. The projector explicitly withholds the above values.
+        // A newer receipt supersedes this full snapshot; do not combine generations or borrow its clock.
+        var expectation = new StatusExpectation(body, native.Epoch, native.Seq, read.HighWater > native.Seq);
+        var snapshot = new StatusSnapshot(body, native.Epoch, native.Seq, Source, StatusOrigin.NativeAdapter,
+            true, read.ReceivedAt, ValueList<StatusFieldObservation>.From(fields));
+        return new(lookup, expectation, snapshot, _policy);
+    }
+}
