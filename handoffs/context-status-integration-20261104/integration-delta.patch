diff --git a/tests/Dit.HumanBehavior.Neuronetwork.Tests/ConversationStatusIntegrationTests.cs b/tests/Dit.HumanBehavior.Neuronetwork.Tests/ConversationStatusIntegrationTests.cs
new file mode 100644
index 0000000..61b5dc7
--- /dev/null
+++ b/tests/Dit.HumanBehavior.Neuronetwork.Tests/ConversationStatusIntegrationTests.cs
@@ -0,0 +1,291 @@
+using System.Reflection;
+using System.Text.Json;
+using System.Text.Json.Serialization;
+using Dit.HumanBehavior.Contracts;
+using Dit.HumanBehavior.DialogueWording;
+using Dit.HumanBehavior.DialogueWording.DeepSeek;
+using Dit.HumanBehavior.Neuronetwork.Conversation;
+using Dit.HumanBehavior.Neuronetwork.Store;
+using Xunit;
+
+namespace Dit.HumanBehavior.Neuronetwork.Tests;
+
+public sealed class ConversationStatusIntegrationTests
+{
+    private static readonly DateTimeOffset Start = new(2030, 1, 1, 0, 0, 0, TimeSpan.Zero);
+    private static readonly string[] History = Enumerable.Range(0, 12).Select(i => $"Player: synthetic turn {i:D2}").ToArray();
+    private sealed class Clock : TimeProvider { public DateTimeOffset Now = Start; public override DateTimeOffset GetUtcNow() => Now; }
+    private sealed class Source : IConversationStatusSource
+    {
+        public int Calls;
+        public Func<ConversationStatusLookup, ConversationStatusCapture?> Read = Fixture;
+        public ConversationStatusCapture? Capture(ConversationStatusLookup lookup) { Calls++; return Read(lookup); }
+    }
+    private sealed class Provider : IDialogueWordingProvider
+    {
+        public string ProviderName => "offline-integration-fixture";
+        public List<DialogueWordingRequest> Requests = [];
+        public Action? DuringWording;
+        public bool Succeed;
+        public Task<DialogueWordingResult> GenerateAsync(DialogueWordingRequest request, CancellationToken token)
+        {
+            Requests.Add(request);
+            DuringWording?.Invoke();
+            return Task.FromResult(new DialogueWordingResult(request.RequestId, ProviderName, "fixture", Succeed ? "hey there" : null,
+                Succeed ? DialogueWordingCompletionStatus.Succeeded : DialogueWordingCompletionStatus.Unavailable, TimeSpan.Zero, null, null, false,
+                Succeed ? DialogueProviderFailureClassification.None : DialogueProviderFailureClassification.Availability, request.GenerationPolicyVersion));
+        }
+    }
+    private static ConversationStatusCapture Fixture(ConversationStatusLookup lookup)
+    {
+        var body = new StatusBodyIdentity(lookup.Game, "synthetic-realm", lookup.ServerInstance, "native-fixture-id");
+        var expected = new StatusExpectation(body, "synthetic-epoch", 7);
+        var fields = ValueList<StatusFieldObservation>.From([
+            new(StatusField.Presence, "online", Start, Start.AddMinutes(1)),
+            new(StatusField.Location, "Synthetic native west entrance", Start, Start.AddMinutes(1)),
+            new(StatusField.Activity, "resting at the entrance", Start, Start.AddMinutes(1)),
+        ]);
+        var frame = new StatusSnapshot(body, expected.Epoch, expected.Sequence, "fixture-native-adapter", StatusOrigin.NativeAdapter, true, Start, fields);
+        var policy = new ConversationStatusPolicy("fixture-native-adapter", "synthetic-policy-v1",
+            Enum.GetValues<StatusField>().ToDictionary(f => f, f => TimeSpan.FromSeconds(f == StatusField.Presence ? 60 : 10)));
+        return new(lookup, expected, frame, policy);
+    }
+    private static ConversationHearer Bot() => new()
+    {
+        ActorKey = "fixture", DisplayName = "Fixture", Addressed = true, Hero = "LegacyPoisonJob", Level = 99,
+        Situation = "LegacyPoisonActivity", Facts = [new("place", "LegacyPoisonPlace"), new("doing", "LegacyPoisonDoing")]
+    };
+    private static CompanionLine Line(string game) => new()
+    {
+        GameId = game, ServerInstanceId = "synthetic-instance", Persona = "Fixture", Speaker = "Player", SpeakerIsOwner = true,
+        Text = "Fixture, are you around?", Channel = game == "ffxi" ? "linkshell" : "party", Shadow = true, History = History,
+        Bot = Bot(), Facts = [new("live_state", "LegacyPoisonLiveState"), new("knowledge_lookup_ref1", "Synthetic reference, not personal status")]
+    };
+    private static ConversationService Service(NeuronetworkStore store, Provider provider, Clock clock, Source? source,
+        string? context = "ffxi,swtor", string? status = "ffxi,swtor") => new(store, provider, clock)
+    {
+        ContextEnvironment = _ => context, StatusEnvironment = _ => status,
+        RecentContextEnvironment = _ => "1", SharedStatusSource = source, QuickReplies = false, KnowledgeAnswers = false
+    };
+    private static DialogueWordingRequest CompanionRequest(ConversationService service, CompanionLine line, bool rewrite = false) =>
+        (DialogueWordingRequest)typeof(ConversationService).GetMethod("CompanionRequest", BindingFlags.NonPublic | BindingFlags.Instance)!
+            .Invoke(service, [line, new ConversationContext.Actor("fixture", "Fixture", "casual", "brief", line.GameId),
+                Array.Empty<string>(), Start, rewrite ? "synthetic rewrite reason" : null])!;
+    private static DialogueWordingPromptTextContent Wire(DialogueWordingRequest request)
+    {
+        var type = typeof(DeepSeekDialogueWordingProvider).Assembly.GetType("Dit.HumanBehavior.DialogueWording.DeepSeek.DeepSeekPromptSerializer")!;
+        var wire = type.GetMethod("Serialize", BindingFlags.Static | BindingFlags.NonPublic)!.Invoke(null, [request, new DeepSeekDialogueWordingOptions()])!;
+        using var json = JsonDocument.Parse((byte[])wire.GetType().GetProperty("Utf8Json")!.GetValue(wire)!);
+        var messages = json.RootElement.GetProperty("messages");
+        var prompt = DialogueWordingPromptText.Build(request);
+        Assert.Equal(prompt.SystemMessage, messages[0].GetProperty("content").GetString());
+        Assert.Equal(prompt.UserMessage, messages[1].GetProperty("content").GetString());
+        return prompt;
+    }
+    private static void AssertBound(ConversationService service, DialogueWordingRequest request, bool known)
+    {
+        var prompt = Wire(request);
+        Assert.DoesNotContain("LegacyPoison", prompt.UserMessage);
+        Assert.Equal(12, prompt.ContextReceipt!.IncludedHistoryTurns);
+        Assert.Equal(History, request.ConversationContext!.History);
+        var binding = Assert.IsType<ConversationStatusBinding>(service.StatusBindingFor(request));
+        Assert.Equal(request.RequestId, binding.RequestId);
+        Assert.Equal(request.RequestId, prompt.ContextReceipt.RequestId);
+        Assert.Equal(known, request.ApprovedGameWorldFacts.Any(f => f.Key == "native_status_location"));
+        Assert.Equal(known ? "native_observed" : "unknown", request.CurrentHighLevelActivity);
+        if (known)
+        {
+            Assert.Contains("Synthetic native west entrance", prompt.UserMessage);
+            Assert.Equal(binding.View!.RevisionSha256, request.ApprovedGameWorldFacts.Single(f => f.Key == "native_status_revision").Value);
+        }
+    }
+
+    [Theory]
+    [InlineData("ffxi", "companion")] [InlineData("swtor", "companion")]
+    [InlineData("ffxi", "heard")] [InlineData("swtor", "heard")]
+    [InlineData("ffxi", "intent")] [InlineData("swtor", "intent")]
+    public async Task Actual_reply_paths_bind_projected_status_and_complete_history_to_wire(string game, string path)
+    {
+        using var store = new NeuronetworkStore(":memory:");
+        var provider = new Provider(); var clock = new Clock(); var source = new Source();
+        var service = Service(store, provider, clock, source);
+        if (path == "companion") await service.CompanionReplyAsync(Line(game), default);
+        if (path == "heard") await service.ReplyAsync(new ConversationHeard
+        {
+            GameId = game, ServerInstanceId = "synthetic-instance", LineId = "synthetic-turn", Channel = "tell",
+            Speaker = new("Player", true), Text = "Fixture, are you around?", Hearers = [Bot()], History = History, Mode = "shadow"
+        }, default);
+        if (path == "intent") await service.WordIntentAsync(game, "synthetic-instance", Bot(), "Say something brief", "party", History, "LegacyPoisonPlace", 120, default);
+        var request = Assert.Single(provider.Requests);
+        AssertBound(service, request, true); Assert.Equal(1, source.Calls);
+        if (Environment.GetEnvironmentVariable("DIT_INTEGRATION_FIXTURE_OUTPUT") is { Length: > 0 } output)
+        {
+            Directory.CreateDirectory(output);
+            var prompt = Wire(request);
+            File.WriteAllText(Path.Combine(output, game + "-" + path + ".json"), JsonSerializer.Serialize(new
+            {
+                schema = "dit.context-status-integration.v1", synthetic = true, game, path,
+                suppliedHistory = History, systemMessage = prompt.SystemMessage, userMessage = prompt.UserMessage,
+                contextReceipt = prompt.ContextReceipt, statusBinding = service.StatusBindingFor(request),
+                delivery = "not attempted", modelCall = "not attempted"
+            }, new JsonSerializerOptions { WriteIndented = true, Converters = { new JsonStringEnumConverter() } }));
+        }
+    }
+
+    [Theory]
+    [InlineData(null, null)] [InlineData("ffxi", null)] [InlineData(null, "ffxi")]
+    [InlineData("ffxi", "ffxi")] [InlineData("ffxi", "swtor")] [InlineData("ffxi", "ffxi-extra")]
+    public void Flags_are_independent_exact_scoped_and_default_off(string? context, string? status)
+    {
+        using var store = new NeuronetworkStore(":memory:");
+        var source = new Source(); var service = Service(store, new Provider(), new Clock(), source, context, status);
+        var request = CompanionRequest(service, Line("ffxi"));
+        Assert.Equal(context == "ffxi", request.ConversationContext is not null);
+        Assert.Equal(status == "ffxi" ? 1 : 0, source.Calls);
+        Assert.Equal(status == "ffxi", service.StatusBindingFor(request) is not null);
+        Assert.Equal(status != "ffxi", DialogueWordingPromptText.Build(request).UserMessage.Contains("LegacyPoison", StringComparison.Ordinal));
+    }
+
+    [Theory]
+    [InlineData("ffxi")] [InlineData("swtor")]
+    public void Rewrite_recaptures_freshness_without_losing_history_or_correction(string game)
+    {
+        using var store = new NeuronetworkStore(":memory:");
+        var clock = new Clock(); var source = new Source(); var service = Service(store, new Provider(), clock, source);
+        var original = CompanionRequest(service, Line(game)); AssertBound(service, original, true);
