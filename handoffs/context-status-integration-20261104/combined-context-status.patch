+using Dit.HumanBehavior.Contracts;
+
+namespace Dit.HumanBehavior.DialogueWording;
+
+/// <summary>
+/// Already-scoped conversation data, separate from behavior/grounding facts.
+/// Legacy callers supply speaker-labelled lines, not authenticated turn IDs or
+/// delivery receipts. This type does not upgrade those lines into observations.
+/// </summary>
+public sealed record DialogueConversationContext
+{
+    public const int MaximumTurns = 32;
+    public const int MaximumTurnCharacters = 512;
+
+    public DialogueConversationContext(ValueList<string>? history, string? currentMessage)
+    {
+        History = DialogueWordingGuard.TextList(history, nameof(history), MaximumTurns, MaximumTurnCharacters);
+        CurrentMessage = currentMessage is null ? null :
+            DialogueWordingGuard.Text(currentMessage, nameof(currentMessage), MaximumTurnCharacters, allowEmpty: false);
+    }
+
+    public ValueList<string> History { get; }
+    public string? CurrentMessage { get; }
+}
+
+/// <summary>Coverage of the exact provider-neutral prompt, not model comprehension or delivery.</summary>
+public sealed record DialogueContextReceipt(
+    string RequestId, int SuppliedHistoryTurns, int IncludedHistoryTurns, int OmittedHistoryTurns,
+    int SerializedCharacters, int MaximumSerializedCharacters, string PromptSha256);
