diff --git a/src/Dit.HumanBehavior.Neuronetwork/Conversation/ConversationService.SharedStatus.cs b/src/Dit.HumanBehavior.Neuronetwork/Conversation/ConversationService.SharedStatus.cs
new file mode 100644
index 0000000..429e4bd
--- /dev/null
+++ b/src/Dit.HumanBehavior.Neuronetwork/Conversation/ConversationService.SharedStatus.cs
@@ -0,0 +1,142 @@
+using System.Runtime.CompilerServices;
+using Dit.HumanBehavior.Contracts;
+using Dit.HumanBehavior.DialogueWording;
+
+namespace Dit.HumanBehavior.Neuronetwork.Conversation;
+
+public sealed record ConversationStatusLookup(string Game, string ServerInstance, string ActorKey);
+public sealed record ConversationStatusCapture(ConversationStatusLookup Lookup, StatusExpectation Expectation,
+    StatusSnapshot? Snapshot, ConversationStatusPolicy Policy);
+
+/// <summary>
+/// Trusted in-process adapter boundary, not a request/JSON contract. Map the
+/// authenticated actor key to its native body and read cursor + snapshot together
+/// from the existing ordered store. This must be a bounded local read, never a
+/// device/provider call. No inferred display-name or realm mapping.
+/// </summary>
+public interface IConversationStatusSource
+{
+    ConversationStatusCapture? Capture(ConversationStatusLookup lookup);
+}
+
+public sealed record ConversationStatusBinding(string RequestId, ConversationStatusLookup Lookup,
+    string State, ConversationStatusView? View);
+
+public sealed partial class ConversationService
+{
+    /// <summary>No source is registered by default. Enabling without a source yields unknown, never legacy status.</summary>
+    public IConversationStatusSource? SharedStatusSource { get; set; }
+    internal Func<string, string?> StatusEnvironment { get; set; } = System.Environment.GetEnvironmentVariable;
+    private readonly ConditionalWeakTable<DialogueWordingRequest, ConversationStatusBinding> _statusBindings = new();
+
+    /// <summary>The exact read used by this request; callers can pair it with the actual serializer receipt.
+    /// No live Admin endpoint or persistent log is added by this in-process accessor.</summary>
+    public ConversationStatusBinding? StatusBindingFor(DialogueWordingRequest request) =>
+        _statusBindings.TryGetValue(request, out var binding) ? binding : null;
+
+    private bool SharedStatusEnabled(string game) =>
+        (StatusEnvironment("DIT_CONVERSATION_STATUS_GAMES") ?? "")
+        .Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
+        .Any(value => string.Equals(value, game, StringComparison.OrdinalIgnoreCase));
+
+    private DialogueWordingRequest WithSharedStatus(DialogueWordingRequest request, string game, string instance, string actorKey)
+    {
+        if (!SharedStatusEnabled(game)) return request;
+        var lookup = new ConversationStatusLookup(game, instance, actorKey);
+        var (state, view) = ReadSharedStatus(lookup);
+        return BindSharedStatus(request, lookup, state, view);
+    }
+
+    private (string State, ConversationStatusView? View) ReadSharedStatus(ConversationStatusLookup lookup)
+    {
+        ConversationStatusView? view = null;
+        var state = "source unavailable";
+        try
+        {
+            if (SharedStatusSource?.Capture(lookup) is { } captured)
+            {
+                // The source owns native-ID/realm mapping, but may not return a
+                // capture requested for another caller, game or server instance.
+                if (captured.Lookup != lookup || captured.Expectation.Body.Game != lookup.Game || captured.Expectation.Body.Instance != lookup.ServerInstance)
+                    state = "source binding mismatch";
+                else
+                {
+                    view = ConversationStatusProjection.Build(captured.Expectation, captured.Snapshot, captured.Policy, _time.GetUtcNow());
+                    state = view.RevisionSha256 is null ? "snapshot unavailable" : "snapshot projected";
+                }
+            }
+        }
+        catch (Exception error) when (error is IOException or UnauthorizedAccessException or InvalidOperationException or ArgumentException)
+        {
+            // Do not log source exception text, paths or values into a prompt.
+            state = "source read failed";
+        }
+        return (state, view);
+    }
+
+    // Recheck just before returning successful wording to the caller. The native
+    // adapter still owns membership/action validation and actual delivery.
+    private bool SharedStatusStillCurrent(DialogueWordingRequest request)
+    {
+        if (!_statusBindings.TryGetValue(request, out var binding)) return true;
+        if (!SharedStatusEnabled(binding.Lookup.Game)) return false;
+        var (state, current) = ReadSharedStatus(binding.Lookup);
+        if (state != binding.State) return false;
+        if (binding.View is not { } previous) return current is null;
+        // A new snapshot/heartbeat with the same fresh facts need not silence
+        // every reply. Refuse regression, identity changes or changed knowledge.
+        return current is not null && current.Body == previous.Body && current.Epoch == previous.Epoch &&
+            current.Sequence >= previous.Sequence && current.Source == previous.Source &&
+            current.FreshnessPolicyVersion == previous.FreshnessPolicyVersion &&
+            current.Fields.Select(f => (f.Field, f.State, f.Value))
+                .SequenceEqual(previous.Fields.Select(f => (f.Field, f.State, f.Value)));
+    }
+
+    private DialogueWordingRequest BindSharedStatus(DialogueWordingRequest request, ConversationStatusLookup lookup,
+        string state, ConversationStatusView? view)
+    {
+        var fields = view?.Fields ?? ValueList<StatusFieldView>.From(Enum.GetValues<StatusField>()
+            .Select(field => new StatusFieldView(field, StatusKnowledge.Unknown, null, state, null, null)));
+        var facts = new List<DialogueContextFact>();
+        foreach (var field in fields)
+        {
+            var name = "native_status_" + field.Field.ToString().ToLowerInvariant();
+            facts.Add(new(name + "_state", field.State.ToString().ToLowerInvariant() + ": " + field.Reason));
+            if (field.State == StatusKnowledge.Known && field.Value is not null)
+                facts.Add(new(name, field.Value));
+        }
+        if (view is not null)
+        {
+            if (view.RevisionSha256 is not null) facts.Add(new("native_status_revision", view.RevisionSha256));
+            facts.Add(new("native_status_policy", view.FreshnessPolicyVersion));
+        }
+        // Conservative migration boundary: old loose game/body facts have no
+        // observation lifetime. Keep explicit game references, not old current
+        // location, activity, level, party or goals. Keep the explicit native
+        // guide outcome: it is action evidence and also prevents a new consult.
+        facts.AddRange(request.ApprovedGameWorldFacts.Where(f => f.Key == "native_guide_action_result"));
+        facts.AddRange(request.ApprovedGameWorldFacts.Where(f =>
+            f.Key.StartsWith("reference_", StringComparison.Ordinal) || f.Key.StartsWith("knowledge_lookup_ref", StringComparison.Ordinal))
+            .Take(32 - facts.Count));
+        var trigger = new List<DialogueContextFact>
+        {
+            new("only_your_own_live_state", "Only known native_status facts describe your current body. Stale or unknown means you do not know; never infer idle, progress or location from chat, memory, plans or missing fields."),
+            new("you_are", YouAreFact(request.Actor.DisplayName ?? lookup.ActorKey, null, null)),
+        };
+        trigger.AddRange(request.TriggerFacts.Where(f => f.Key is not ("only_your_own_live_state" or "you_are" or "verified_live_state" or "party_stance"))
+            .Select(f => f.Key == "moment" ? new DialogueContextFact("moment", ConversationContext.Clamp("Social intent, not a native observation: " + f.Value)) : f)
+            .Take(16 - trigger.Count));
+        var activity = fields.First(f => f.Field == StatusField.Activity);
+        var prepared = new DialogueWordingRequest(
+            request.IntentionId, request.Game, request.Actor, request.SemanticTopic, request.SemanticIntent, request.TriggerType,
+            ValueList<DialogueContextFact>.From(trigger), request.Channel, request.AudienceType,
+            request.PersonalitySummary, request.CommunicationStyle, request.RelevantMemories, request.RelationshipRole, request.RelationshipSummary,
+            activity.State == StatusKnowledge.Known ? "native_observed" : "unknown",
+            ValueList<DialogueContextFact>.From(facts), request.MaximumOutputCharacters, request.MaximumOutputUtf8Bytes,
+            request.Locale, request.GenerationPolicyVersion, request.TemplateFamily, request.DeterministicFallbackText,
+            request.FallbackPolicy, request.OutputConstraints, request.RequestedAtUtc, request.ExpiresAtUtc, request.CorrelationId, request.CausationId,
+            request.SharedEventMemorySummary, request.ConversationContext);
+        _statusBindings.Add(prepared, new(prepared.RequestId, lookup, state, view));
+        return prepared;
+    }
+}
