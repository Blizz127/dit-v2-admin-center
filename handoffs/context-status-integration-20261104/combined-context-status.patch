+using System.Reflection;
+using System.Security.Cryptography;
+using System.Text;
+using System.Text.Json;
+using Dit.HumanBehavior.Contracts;
+using Dit.HumanBehavior.DialogueWording;
+using Dit.HumanBehavior.DialogueWording.DeepSeek;
+using Dit.HumanBehavior.Neuronetwork.Conversation;
+using Dit.HumanBehavior.Neuronetwork.Conversation.Arbitration;
+using Dit.HumanBehavior.Neuronetwork.Store;
+using Xunit;
+
+namespace Dit.HumanBehavior.Neuronetwork.Tests;
+
+public sealed class StructuredConversationTests
+{
+    private static readonly DateTimeOffset Now = new(2030, 1, 1, 0, 0, 0, TimeSpan.Zero);
+    private static readonly string[] Exchange = [
+        "Player: That area was rough.", "Bot A: The pulls got messy near the entrance.",
+        "Player: Was it the links?", "Bot A: Two groups arrived together.",
+        "Player: I meant the western entrance.", "Bot A: Right, the western one.",
+        "Player: Was it the links?", "Bot A: Yes, that was the problem there.",
+        "Player: Let us try a different route.", "Bot A: We can discuss it before moving.",
+        "Player: Which route were we talking about?", "Bot A: The western entrance route."
+    ];
+
+    private sealed class Capture : IDialogueWordingProvider
+    {
+        public string ProviderName => "offline-context-fixture";
+        public List<DialogueWordingRequest> Requests { get; } = [];
+        public Task<DialogueWordingResult> GenerateAsync(DialogueWordingRequest request, CancellationToken token)
+        {
+            Requests.Add(request);
+            return Task.FromResult(new DialogueWordingResult(request.RequestId, ProviderName, "fixture", "",
+                DialogueWordingCompletionStatus.Unavailable, TimeSpan.Zero, null, null, false,
