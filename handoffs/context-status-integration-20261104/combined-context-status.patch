+    [Fact]
+    public void History_budget_omits_whole_oldest_turns_and_reports_actual_coverage()
+    {
+        var history = Enumerable.Range(0, 32).Select(i => $"Player {i:D2}: " + new string('x', 490)).ToArray();
+        var request = Request(history: history);
+        var facts = ValueList<DialogueContextFact>.From(Enumerable.Range(0, 32).Select(i => new DialogueContextFact("fixture_" + i, new string('v', 256))));
+        request = Copy(request, request.ConversationContext, facts);
+        var prompt = DialogueWordingPromptText.Build(request);
+        var receipt = prompt.ContextReceipt!;
+        Assert.InRange(receipt.OmittedHistoryTurns, 1, 31);
+        Assert.Equal(32, receipt.IncludedHistoryTurns + receipt.OmittedHistoryTurns);
+        Assert.DoesNotContain(history[0], prompt.UserMessage);
+        foreach (var turn in history.TakeLast(receipt.IncludedHistoryTurns)) Assert.Contains(turn, prompt.UserMessage);
+        Assert.Contains("LATEST LINE, the one you are answering:", prompt.UserMessage);
+        AssertReceipt(prompt);
+    }
