+++ b/tests/Dit.HumanBehavior.Neuronetwork.Tests/PreparedActionMemoryTests.cs
@@ -0,0 +1,168 @@
+using System.Text.Json;
+using Dit.HumanBehavior.DialogueWording;
+using Dit.HumanBehavior.Neuronetwork.Conversation;
+using Dit.HumanBehavior.Neuronetwork.Goals;
+using Dit.HumanBehavior.Neuronetwork.Store;
+using Xunit;
+
+namespace Dit.HumanBehavior.Neuronetwork.Tests;
+
+public sealed class PreparedActionMemoryTests
+{
+    private static readonly DateTimeOffset Start = new(2030, 1, 1, 0, 0, 0, TimeSpan.Zero);
+    private static readonly string[] Observed =
+    [
+        "PlayerFixture: an earlier question",
+        "Fixture: a supplied observed line",
+        "PlayerFixture: the same intentional line",
+        "PlayerFixture: the same intentional line",
+    ];
+
+    private sealed class Clock : TimeProvider
+    {
+        public DateTimeOffset Now = Start;
+        public override DateTimeOffset GetUtcNow() => Now;
+    }
+
+    private sealed class Provider(params string[] replies) : IDialogueWordingProvider
+    {
+        public readonly List<DialogueWordingRequest> Requests = [];
+        public string ProviderName => "synthetic-prepared-action-memory";
+        public Task<DialogueWordingResult> GenerateAsync(DialogueWordingRequest request, CancellationToken token)
+        {
+            Requests.Add(request);
+            return Task.FromResult(new DialogueWordingResult(request.RequestId, ProviderName, "fake",
+                replies[Math.Min(Requests.Count - 1, replies.Length - 1)],
+                DialogueWordingCompletionStatus.Succeeded, TimeSpan.Zero, null, null, true,
+                DialogueProviderFailureClassification.None, request.GenerationPolicyVersion));
+        }
+    }
+
+    private static ConversationService Service(NeuronetworkStore store, Provider provider, Clock clock, string game, bool selected) =>
+        new(store, provider, clock)
+        {
+            ContextEnvironment = _ => selected ? game : null,
+            StatusEnvironment = _ => null, ChatVoiceEnvironment = _ => null,
+            QuickReplies = false, KnowledgeAnswers = false,
+        };
+
+    private static ConversationHeard Heard(string game, string id, string text) => new()
+    {
+        GameId = game, ServerInstanceId = "synthetic-instance", LineId = id,
+        Channel = "party", Speaker = new ConversationSpeaker("PlayerFixture", true),
+        Text = text, OccurredAtUtc = Start, AcceptsCommands = true,
+        Hearers = [new ConversationHearer { ActorKey = "fixture-bot", DisplayName = "Fixture", Addressed = true, InPartyWithSpeaker = true }],
+        History = Observed,
+    };
+
+    [Theory]
+    [InlineData("ffxi", true, false)] [InlineData("swtor", true, false)]
+    [InlineData("ffxi", false, false)] [InlineData("swtor", false, false)]
+    [InlineData("ffxi", true, true)] [InlineData("swtor", true, true)]
+    [InlineData("ffxi", false, true)] [InlineData("swtor", false, true)]
+    public async Task Prepared_command_is_remembered_as_a_request_without_native_completion(string game, bool selected, bool fromCanary)
+    {
+        using var store = new NeuronetworkStore(":memory:");
+        var clock = new Clock();
+        var provider = new Provider("unused command wording", "maybe tomorrow");
+        var service = Service(store, provider, clock, game, selected);
+        // This test catalog asserts no native capability; no body or goal executor is installed.
+        var catalog = new CommandCatalog(game,
+            [new BotCommand("stay", "Synthetic fixture request", [new("seconds", "int", "Synthetic duration")], "synthetic-only")],
+            "Offline memory test only");
+        var command = JsonSerializer.SerializeToElement(new { command = "stay", args = new { seconds = 7 }, bots = new[] { "Fixture" }, reply = "on it" });
+        var ordinaryCalls = 0;
+        var routedCalls = 0;
+        service.Interpreter = new CommandInterpreter(_ => catalog, (_, _, _) =>
+        {
+            ordinaryCalls++;
+            return Task.FromResult((command, "synthetic-command"));
+        })
+        {
+            Routed = fromCanary ? (_, _, _, _) =>
+            {
+                routedCalls++;
+                return Task.FromResult<(JsonElement Json, string Provider)?>((command, "synthetic-canary-route"));
+            } : null,
+        };
+        service.Memory.Note(game, "fixture-bot", "A supplied earlier observation", Start.AddSeconds(-1));
+        var heard = Heard(game, "synthetic-command", "stay here");
+
+        var decision = Assert.Single((await service.ReplyAsync(heard, default)).Decisions);
+        Assert.Equal("command", decision.Kind);
+        Assert.Equal("stay", decision.Command);
+        Assert.Equal(7, decision.Arguments!.Value.GetProperty("seconds").GetInt32());
+        Assert.Equal(new[] { "Fixture" }, decision.Bots);
+        Assert.Equal("on it", decision.Text);
+        Assert.Equal("command", decision.Origin);
+        Assert.Equal(fromCanary ? 0 : 1, ordinaryCalls);
+        Assert.Equal(fromCanary ? 1 : 0, routedCalls);
+        Assert.Single(provider.Requests); // Parallel wording was prepared and discarded.
+        var requestOnly = selected || fromCanary;
+        var expectedMemory = "PlayerFixture told us \"stay here\"; " +
+            (requestOnly ? "requested stay; completion unconfirmed" : "I did stay");
+        var journal = service.Memory.Get(game, "fixture-bot")!.Journal;
+        Assert.Equal(2, journal.Count);
+        Assert.Equal(expectedMemory, journal.Last().Text);
+        Assert.Contains(journal, entry => entry.Text == "A supplied earlier observation");
+
+        // Returning the prepared command still reserves its line without executing or completing it.
+        Assert.Equal("silence", Assert.Single((await service.ReplyAsync(heard, default)).Decisions).Kind);
+        Assert.Single(provider.Requests);
+        Assert.Equal(1, ordinaryCalls + routedCalls);
+        Assert.Equal(2, service.Memory.Get(game, "fixture-bot")!.Journal.Count);
+
+        clock.Now = Start.AddSeconds(31);
+        var nextHeard = Heard(game, "synthetic-next", "what about tomorrow?") with { OccurredAtUtc = clock.Now };
+        var nextDecision = Assert.Single((await service.ReplyAsync(nextHeard, default)).Decisions);
+        Assert.Equal("say", nextDecision.Kind);
+        Assert.Equal("maybe tomorrow", nextDecision.Text);
+        Assert.Equal(2, provider.Requests.Count);
+        Assert.Equal(1, ordinaryCalls + routedCalls);
+        var next = provider.Requests[1];
+        Assert.Contains(next.RelevantMemories, text => text.Contains(expectedMemory, StringComparison.Ordinal));
+        Assert.Contains(next.RelevantMemories, text => text.Contains("A supplied earlier observation", StringComparison.Ordinal));
+        Assert.Equal(!requestOnly, next.RelevantMemories.Any(text => text.Contains("I did stay", StringComparison.Ordinal)));
+        Assert.DoesNotContain(next.RelevantMemories, text => text.Contains("unused command wording", StringComparison.Ordinal));
+        if (selected)
+        {
+            Assert.Equal(Observed, next.ConversationContext!.History);
+            Assert.Equal(nextHeard.Text, next.ConversationContext.CurrentMessage);
+        }
+        else Assert.Null(next.ConversationContext);
+        if (requestOnly)
+            Assert.DoesNotContain("I did stay", DialogueWordingPromptText.Build(next, game).UserMessage);
+    }
+
+    [Theory]
+    [InlineData("ffxi", true)] [InlineData("swtor", true)]
+    [InlineData("ffxi", false)] [InlineData("swtor", false)]
+    public async Task Requested_emote_returns_an_instruction_without_booking_performed_action_memory(string game, bool selected)
+    {
+        using var store = new NeuronetworkStore(":memory:");
+        var clock = new Clock();
+        var provider = new Provider("maybe tomorrow");
+        var service = Service(store, provider, clock, game, selected);
+        service.Memory.Note(game, "fixture-bot", "A supplied earlier observation", Start.AddSeconds(-1));
+        var heard = Heard(game, "synthetic-emote", "please wave") with { Emotes = ["wave"] };
+
+        var decision = Assert.Single((await service.ReplyAsync(heard, default)).Decisions);
+        Assert.Equal("emote", decision.Kind);
+        Assert.Equal("emote", decision.Channel);
+        Assert.Equal("wave", decision.Text);
+        Assert.Empty(provider.Requests);
+        Assert.Equal("A supplied earlier observation", Assert.Single(service.Memory.Get(game, "fixture-bot")!.Journal).Text);
+        Assert.Equal("silence", Assert.Single((await service.ReplyAsync(heard, default)).Decisions).Kind);
+        Assert.Empty(provider.Requests);
+
+        clock.Now = Start.AddSeconds(31);
+        var nextDecision = Assert.Single((await service.ReplyAsync(
+            Heard(game, "synthetic-next", "what about tomorrow?") with { OccurredAtUtc = clock.Now }, default)).Decisions);
+        Assert.Equal("say", nextDecision.Kind);
+        var next = Assert.Single(provider.Requests);
+        Assert.Contains(next.RelevantMemories, text => text.Contains("A supplied earlier observation", StringComparison.Ordinal));
+        Assert.DoesNotContain(next.RelevantMemories, text => text.Contains("did /wave", StringComparison.Ordinal));
+        Assert.DoesNotContain("did /wave", DialogueWordingPromptText.Build(next, game).UserMessage);
+        Assert.DoesNotContain(service.Memory.Get(game, "fixture-bot")!.Journal, entry => entry.Text.Contains("did /wave", StringComparison.Ordinal));
+    }
+}
diff --git a/tests/Dit.HumanBehavior.Neuronetwork.Tests/ProducerContextBoundaryTests.cs b/tests/Dit.HumanBehavior.Neuronetwork.Tests/ProducerContextBoundaryTests.cs
new file mode 100644
index 0000000000000000000000000000000000000000..a8d0046ba7e3ecc91ddfc55f2d4cb67565f84512
--- /dev/null
+++ b/tests/Dit.HumanBehavior.Neuronetwork.Tests/ProducerContextBoundaryTests.cs
@@ -0,0 +1,172 @@
+using System.Net;
+using System.Text;
+using System.Text.Json;
+using Dit.HumanBehavior.Contracts;
+using Dit.HumanBehavior.DialogueWording;
+using Dit.HumanBehavior.Neuronetwork.Client;
+using Xunit;
+
+namespace Dit.HumanBehavior.Neuronetwork.Tests;
+
+[Collection("Producer context environment")]
+public sealed class ProducerContextBoundaryTests
+{
+    private const string MatchingText = "fixture response";
+    private const string WrongText = "unrelated prepared wording";
+    private const string LocalText = "fixture local response";
+
+    private sealed class Local : IDialogueWordingProvider
+    {
+        public string ProviderName => "fixture-local";
+        public int Calls;
+        public Task<DialogueWordingResult> GenerateAsync(DialogueWordingRequest request, CancellationToken ct)
+        {
+            Calls++;
+            return Task.FromResult(new DialogueWordingResult(request.RequestId, ProviderName, "fixture", LocalText,
+                DialogueWordingCompletionStatus.Succeeded, TimeSpan.Zero, null, null, false,
+                DialogueProviderFailureClassification.None, request.GenerationPolicyVersion));
+        }
+    }
+
+    private sealed class Hub(string fault, bool groupShadow) : HttpMessageHandler
+    {
+        private int _calls;
+        public int Calls => _calls;
+        protected override async Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken ct)
+        {
+            Interlocked.Increment(ref _calls);
+            using var body = JsonDocument.Parse(await request.Content!.ReadAsStringAsync(ct));
+            var path = request.RequestUri!.AbsolutePath;
+            var applies = fault != "none" && (!groupShadow || path.EndsWith("/group", StringComparison.Ordinal));
+            var text = applies ? WrongText : MatchingText;
+            object response;
+            if (path.EndsWith("/event", StringComparison.Ordinal))
+            {
+                var actor = body.RootElement.GetProperty("bot").GetProperty("actorKey").GetString();
+                response = new { actorKey = applies && fault == "actor" ? "another-fixture" : applies && fault == "actor-case" ? actor!.ToUpperInvariant() : actor, kind = "say", text, note = "fixture" };
+            }
+            else
+            {
+                var actor = body.RootElement.GetProperty("hearers")[0].GetProperty("actorKey").GetString();
+                var lineId = body.RootElement.GetProperty("lineId").GetString();
+                var decision = new
+                {
+                    actorKey = applies && fault == "actor" ? "another-fixture" : applies && fault == "actor-case" ? actor!.ToUpperInvariant() : actor,
+                    displayName = "Fixture", kind = "say", channel = "tell", text,
+                    reason = "fixture", origin = "fixture", model = "fixture", note = "fixture",
+                };
+                response = new
+                {
+                    lineId = applies && fault == "line" ? "another-line" : lineId, mode = "live",
+                    decisions = applies && fault == "duplicate" ? new[] { decision, decision with { text = "conflicting second draft" } } :
+                        applies && fault == "case-first" ? new[] { decision with { actorKey = actor!.ToUpperInvariant() }, decision } :
+                        applies && fault == "case-last" ? new[] { decision, decision with { actorKey = actor!.ToUpperInvariant() } } : new[] { decision },
+                    notes = Array.Empty<string>(),
+                };
+            }
+            return new(HttpStatusCode.OK) { Content = new StringContent(JsonSerializer.Serialize(response), Encoding.UTF8, "application/json") };
+        }
+    }
+
+    private sealed record Forwarded(DialogueWordingResult Result, IReadOnlyList<string> Reports, int LocalCalls, int HubCalls,
+        int HubAnswers, int HubSilences);
+
+    private static async Task<Forwarded> Forward(string game, string route, string fault, bool selected, string mode = "only")
+    {
+        using var temp = new TempDirectory();
+        var groupShadow = route == "group-shadow";
+        var env = new Dictionary<string, string?>
+        {
+            ["DIT_NEURONETWORK_CONSULT_TOKEN_DIRECTORY"] = temp.Path,
+            ["DIT_" + game.ToUpperInvariant() + "_HUB_CONVERSATION"] = mode,
+            ["DIT_" + game.ToUpperInvariant() + "_GROUP"] = groupShadow ? "shadow" : route == "group" ? "live" : "off",
+            ["DIT_" + game.ToUpperInvariant() + "_GROUP_ACTORS"] = "",
+        };
+        var before = env.Keys.ToDictionary(key => key, Environment.GetEnvironmentVariable);
+        try
+        {
+            foreach (var (key, value) in env) Environment.SetEnvironmentVariable(key, value);
+            File.WriteAllText(Path.Combine(temp.Path, game + ".token"), "synthetic-token");
+            var handler = new Hub(fault, groupShadow);
+            using var http = new HttpClient(handler);
+            var hub = new NeuronetConversationClient(game, http, "http://fixture.invalid");
+            var local = new Local();
+            var reports = new List<string>();
+            using var provider = new NeuronetConversationWordingProvider(local, hub, "fixture-instance", reports.Add);
+            provider.ContextEnvironment = _ => selected ? game : null;
+            var now = DateTimeOffset.UtcNow;
+            var current = route == "event" ? null : "Fixture current message";
+            var trigger = current is null ? ValueList<DialogueContextFact>.Empty :
+                ValueList<DialogueContextFact>.From([new("untrusted_player_message", "Legacy current message")]);
+            var request = new DialogueWordingRequest("fixture-intent", new(game, "fixture-instance", GameEnvironment.IsolatedTest),
+                new(ActorIdentityKind.GameNativeActor, "player_bot", "fixture", null, "Fixture"), "social_nearby", "Say something brief",
+                "fixture.turn", trigger, "tell", "single_player", "Friendly", "Brief", null, "stranger", "Synthetic conversation",
+                "unknown", null, 100, 200, "en-US", "fixture-v1", "neuronet_conversation", "...", DialogueFallbackPolicy.Silence,
+                new DialogueOutputConstraints(), now, now.AddSeconds(30), "fixture-line",
+                conversationContext: new(ValueList<string>.From(["Player: earlier line"]), current));
+            var result = await provider.GenerateAsync(request, default);
+            return new(result, reports, local.Calls, handler.Calls, provider.HubAnswers, provider.HubSilences);
+        }
+        finally { foreach (var (key, value) in before) Environment.SetEnvironmentVariable(key, value); }
+    }
+
+    [Theory]
+    [InlineData("ffxi", "reply", "line")] [InlineData("swtor", "reply", "line")]
+    [InlineData("ffxi", "reply", "actor")] [InlineData("swtor", "reply", "actor")]
+    [InlineData("ffxi", "reply", "duplicate")] [InlineData("swtor", "reply", "duplicate")]
+    [InlineData("ffxi", "group", "line")] [InlineData("swtor", "group", "line")]
+    [InlineData("ffxi", "group", "duplicate")] [InlineData("swtor", "group", "duplicate")]
+    [InlineData("ffxi", "event", "actor")] [InlineData("swtor", "event", "actor")]
+    [InlineData("ffxi", "reply", "actor-case")] [InlineData("swtor", "reply", "actor-case")]
+    [InlineData("ffxi", "group", "actor-case")] [InlineData("swtor", "group", "actor-case")]
+    [InlineData("ffxi", "group", "case-first")] [InlineData("swtor", "group", "case-first")]
+    [InlineData("ffxi", "group", "case-last")] [InlineData("swtor", "group", "case-last")]
+    [InlineData("ffxi", "event", "actor-case")] [InlineData("swtor", "event", "actor-case")]
+    public async Task Selected_context_withholds_wrong_or_ambiguous_response_without_changing_legacy(string game, string route, string fault)
+    {
+        var rejected = await Forward(game, route, fault, selected: true);
+        Assert.Null(rejected.Result.CandidateText);
+        Assert.Equal("hub_response_mismatch", rejected.Result.SafeTelemetryMetadata["hub_decision"]);
+        Assert.Equal(0, rejected.HubAnswers);
+        Assert.Equal(1, rejected.HubSilences);
+        Assert.Equal(0, rejected.LocalCalls);
+        Assert.Equal(1, rejected.HubCalls);
+        Assert.Contains(rejected.Reports, report => report.Contains("response scope mismatch", StringComparison.Ordinal));
+        Assert.DoesNotContain(rejected.Reports, report => report.Contains(WrongText, StringComparison.Ordinal));
+
+        var matching = await Forward(game, route, "none", selected: true);
+        Assert.Equal(MatchingText, matching.Result.CandidateText);
+        Assert.Equal(1, matching.HubAnswers);
+        Assert.Equal(0, matching.HubSilences);
+
+        var legacy = await Forward(game, route, fault, selected: false);
+        Assert.Equal(WrongText, legacy.Result.CandidateText);
+        Assert.Equal(1, legacy.HubAnswers);
+        Assert.Equal(0, legacy.HubSilences);
+    }
+
+    [Theory]
+    [InlineData("ffxi")] [InlineData("swtor")]
+    public async Task Selected_live_mismatch_does_not_invoke_local_fallback(string game)
+    {
+        var rejected = await Forward(game, "reply", "actor", selected: true, mode: "live");
+        Assert.Null(rejected.Result.CandidateText);
+        Assert.Equal("hub_response_mismatch", rejected.Result.SafeTelemetryMetadata["hub_decision"]);
+        Assert.Equal(0, rejected.LocalCalls);
+        Assert.Equal(1, rejected.HubCalls);
+    }
+
+    [Theory]
+    [InlineData("ffxi", false)] [InlineData("swtor", false)]
+    [InlineData("ffxi", true)] [InlineData("swtor", true)]
+    public async Task Rejected_shadow_text_is_not_reported_and_does_not_replace_authoritative_wording(string game, bool group)
+    {
+        var result = await Forward(game, group ? "group-shadow" : "reply", "line", selected: true, mode: group ? "only" : "shadow");
+        Assert.Equal(group ? MatchingText : LocalText, result.Result.CandidateText);
+        Assert.Equal(group ? 0 : 1, result.LocalCalls);
+        Assert.Equal(group ? 2 : 1, result.HubCalls);
+        Assert.Contains(result.Reports, report => report.Contains("response scope mismatch", StringComparison.Ordinal));
+        Assert.DoesNotContain(result.Reports, report => report.Contains(WrongText, StringComparison.Ordinal));
+        Assert.DoesNotContain(result.Reports, report => report.Contains("hub unreachable", StringComparison.Ordinal));
+    }
+}
diff --git a/tests/Dit.HumanBehavior.Neuronetwork.Tests/StatusCommandDelayTests.cs b/tests/Dit.HumanBehavior.Neuronetwork.Tests/StatusCommandDelayTests.cs
new file mode 100644
index 0000000000000000000000000000000000000000..eeca5493151cc06e906c4116889f88a29a3c2b1b
--- /dev/null
+++ b/tests/Dit.HumanBehavior.Neuronetwork.Tests/StatusCommandDelayTests.cs
@@ -0,0 +1,150 @@
+using System.Text.Json;
+using Dit.HumanBehavior.Contracts;
+using Dit.HumanBehavior.DialogueWording;
+using Dit.HumanBehavior.Neuronetwork.Conversation;
+using Dit.HumanBehavior.Neuronetwork.Goals;
+using Dit.HumanBehavior.Neuronetwork.Store;
+using Xunit;
+
+namespace Dit.HumanBehavior.Neuronetwork.Tests;
+
+public sealed class StatusCommandDelayTests
+{
+    private static readonly DateTimeOffset Start = new(2030, 1, 1, 0, 0, 0, TimeSpan.Zero);
+    private const string PreparedText = "waiting by the west entrance";
+
+    private sealed class Clock : TimeProvider
+    {
+        public DateTimeOffset Now = Start;
+        public override DateTimeOffset GetUtcNow() => Now;
+    }
+
+    private sealed class Provider : IDialogueWordingProvider
+    {
+        public string ProviderName => "synthetic-status-command-delay";
+        public readonly List<DialogueWordingRequest> Requests = [];
+        public Task<DialogueWordingResult> GenerateAsync(DialogueWordingRequest request, CancellationToken ct)
+        {
+            Requests.Add(request);
+            return Task.FromResult(new DialogueWordingResult(request.RequestId, ProviderName, "fixture", PreparedText,
+                DialogueWordingCompletionStatus.Succeeded, TimeSpan.Zero, null, null, false,
+                DialogueProviderFailureClassification.None, request.GenerationPolicyVersion));
+        }
+    }
+
+    private sealed class Source : IConversationStatusSource
+    {
+        public int Calls;
+        public string Location = "Synthetic west entrance";
+        public long Sequence = 7;
+        public ConversationStatusCapture Capture(ConversationStatusLookup lookup)
+        {
+            Calls++;
+            var body = new StatusBodyIdentity(lookup.Game, "synthetic-realm", lookup.ServerInstance, "native-fixture");
+            var expectation = new StatusExpectation(body, "synthetic-epoch", Sequence);
+            var fields = ValueList<StatusFieldObservation>.From([
+                new(StatusField.Presence, "online", Start, Start.AddMinutes(1)),
+                new(StatusField.Location, Location, Start, Start.AddMinutes(1)),
+                new(StatusField.Activity, "waiting at the entrance", Start, Start.AddMinutes(1)),
+            ]);
+            var snapshot = new StatusSnapshot(body, expectation.Epoch, Sequence, "synthetic-adapter", StatusOrigin.NativeAdapter,
+                true, Start, fields);
+            var policy = new ConversationStatusPolicy("synthetic-adapter", "synthetic-expiry-v1",
+                Enum.GetValues<StatusField>().ToDictionary(field => field, field => TimeSpan.FromSeconds(field == StatusField.Presence ? 60 : 10)));
+            return new(lookup, expectation, snapshot, policy);
+        }
+    }
+
+    private static ConversationHeard Heard(string game) => new()
+    {
+        GameId = game, ServerInstanceId = "synthetic-instance", LineId = "synthetic-command-delay", Channel = "party",
+        Speaker = new("PlayerFixture", true), Text = "stay here", OccurredAtUtc = Start, AcceptsCommands = true,
+        Hearers = [new() { ActorKey = "fixture-bot", DisplayName = "Fixture", Addressed = true, InPartyWithSpeaker = true }],
+        History = ["PlayerFixture: an earlier supplied line"], Mode = "live",
+    };
+
+    private static ConversationService Service(NeuronetworkStore store, Provider provider, Clock clock, Source source,
+        string game, bool selected) => new(store, provider, clock)
+    {
+        ContextEnvironment = _ => game, StatusEnvironment = _ => selected ? game : null,
+        SharedStatusSource = source, ChatVoiceEnvironment = _ => null,
+        QuickReplies = false, KnowledgeAnswers = false,
+    };
+
+    private static CommandCatalog Catalog(string game) => new(game,
+        [new BotCommand("stay", "Synthetic fixture instruction", [new("seconds", "int", "Synthetic duration")], "synthetic-only")],
+        "No native executor is installed");
+
+    [Theory]
+    [InlineData("ffxi", "expired", true, false)] [InlineData("swtor", "expired", true, false)]
+    [InlineData("ffxi", "changed", true, false)] [InlineData("swtor", "changed", true, false)]
+    [InlineData("ffxi", "expired", true, true)] [InlineData("swtor", "expired", true, true)]
+    [InlineData("ffxi", "unchanged", true, false)] [InlineData("swtor", "unchanged", true, false)]
+    [InlineData("ffxi", "expired", false, false)] [InlineData("swtor", "expired", false, false)]
+    public async Task Completed_wording_is_rechecked_after_a_later_command_decline_or_failure(
+        string game, string change, bool selected, bool interpreterFails)
+    {
+        using var store = new NeuronetworkStore(":memory:");
+        var provider = new Provider(); var clock = new Clock(); var source = new Source();
+        var service = Service(store, provider, clock, source, game, selected);
+        var commands = 0;
+        service.Interpreter = new CommandInterpreter(_ => Catalog(game), (_, _, _) =>
+        {
+            commands++;
+            Assert.Single(provider.Requests);
+            // Task.FromResult wording has already completed WordAsync's own
+            // status recheck before this simulated interpreter delay begins.
+            Assert.Equal(selected ? 2 : 0, source.Calls);
+            clock.Now = Start.AddSeconds(change == "expired" ? 10 : 1);
+            if (change == "changed") { source.Location = "Synthetic east entrance"; source.Sequence++; }
+            if (interpreterFails) throw new HttpRequestException("synthetic interpreter failure");
+            return Task.FromResult((JsonSerializer.SerializeToElement(new { command = "none" }), "synthetic-interpreter"));
+        });
+
+        var reply = await service.ReplyAsync(Heard(game), default);
+        var decision = Assert.Single(reply.Decisions);
+        var accepted = !selected || change == "unchanged";
+        Assert.Equal(accepted ? "say" : "silence", decision.Kind);
+        Assert.Equal(accepted ? PreparedText : null, decision.Text);
+        Assert.Equal(1, commands);
+        var request = Assert.Single(provider.Requests);
+        Assert.Equal(selected, service.StatusBindingFor(request) is not null);
+        Assert.Equal(selected ? 3 : 0, source.Calls);
+        if (selected)
+            Assert.Contains(request.ApprovedGameWorldFacts, fact => fact.Key == "native_status_location" && fact.Value == "Synthetic west entrance");
+        if (!accepted)
+        {
+            Assert.Equal("shared status changed before reply selection", decision.Reason);
+            Assert.Contains("shared status changed before reply selection", reply.Notes);
+            Assert.DoesNotContain(reply.Notes, note => note.Contains(PreparedText, StringComparison.Ordinal));
+            Assert.Equal(0, service.Spoken);
+        }
+        if (interpreterFails) Assert.Contains("command interpreter failed: HttpRequestException", reply.Notes);
+    }
+
+    [Theory]
+    [InlineData("ffxi")] [InlineData("swtor")]
+    public async Task A_successful_command_still_returns_its_instruction_without_reusing_discarded_wording(string game)
+    {
+        using var store = new NeuronetworkStore(":memory:");
+        var provider = new Provider(); var clock = new Clock(); var source = new Source();
+        var service = Service(store, provider, clock, source, game, selected: true);
+        service.Interpreter = new CommandInterpreter(_ => Catalog(game), (_, _, _) =>
+        {
+            Assert.Single(provider.Requests);
+            Assert.Equal(2, source.Calls);
+            clock.Now = Start.AddSeconds(10);
+            var command = JsonSerializer.SerializeToElement(new { command = "stay", args = new { seconds = 7 }, bots = new[] { "Fixture" }, reply = "on it" });
+            return Task.FromResult((command, "synthetic-interpreter"));
+        });
+
+        var decision = Assert.Single((await service.ReplyAsync(Heard(game), default)).Decisions);
+        Assert.Equal("command", decision.Kind);
+        Assert.Equal("stay", decision.Command);
+        Assert.Equal("on it", decision.Text);
+        Assert.Equal(7, decision.Arguments!.Value.GetProperty("seconds").GetInt32());
+        Assert.Equal(new[] { "Fixture" }, decision.Bots);
+        Assert.Single(provider.Requests);
+        Assert.Equal(2, source.Calls);
+    }
+}
diff --git a/tests/Dit.HumanBehavior.Neuronetwork.Tests/StatusFallbackBindingTests.cs b/tests/Dit.HumanBehavior.Neuronetwork.Tests/StatusFallbackBindingTests.cs
new file mode 100644
index 0000000000000000000000000000000000000000..8e3388f42e157c29e94cccf89c15eda09017e409
--- /dev/null
+++ b/tests/Dit.HumanBehavior.Neuronetwork.Tests/StatusFallbackBindingTests.cs
@@ -0,0 +1,115 @@
+using Dit.HumanBehavior.Contracts;
+using Dit.HumanBehavior.DialogueWording;
+using Dit.HumanBehavior.Neuronetwork.Conversation;
+using Dit.HumanBehavior.Neuronetwork.Store;
+using Xunit;
+
+namespace Dit.HumanBehavior.Neuronetwork.Tests;
+
+public sealed class StatusFallbackBindingTests
+{
+    private static readonly DateTimeOffset Start = new(2030, 1, 1, 0, 0, 0, TimeSpan.Zero);
+
+    private sealed class Clock : TimeProvider
+    {
+        public DateTimeOffset Now = Start;
+        public override DateTimeOffset GetUtcNow() => Now;
+    }
+
+    private sealed class Source(Clock clock, string change) : IConversationStatusSource
+    {
+        public int Calls;
+        public ConversationStatusCapture Capture(ConversationStatusLookup lookup)
+        {
+            Calls++;
+            // The first draft passes its own post-generation check. Change the
+            // status only when the next rewrite captures a new request binding.
+            if (Calls == 3 && change == "expired") clock.Now = Start.AddSeconds(10);
+            if (Calls == 3 && change == "location") clock.Now = Start.AddSeconds(1);
+            var moved = Calls >= 3 && change == "location";
+            var body = new StatusBodyIdentity(lookup.Game, "synthetic-realm", lookup.ServerInstance, "synthetic-native-id");
+            var expected = new StatusExpectation(body, "synthetic-epoch", moved ? 8 : 7);
+            var fields = ValueList<StatusFieldObservation>.From([
+                new(StatusField.Presence, "online", Start, Start.AddMinutes(1)),
+                new(StatusField.Location, moved ? "Synthetic east entrance" : "Synthetic west entrance", Start, Start.AddMinutes(1)),
+                new(StatusField.Activity, "resting at the entrance", Start, Start.AddMinutes(1)),
+            ]);
+            var snapshot = new StatusSnapshot(body, expected.Epoch, expected.Sequence, "synthetic-adapter",
+                StatusOrigin.NativeAdapter, true, moved ? Start.AddSeconds(1) : Start, fields);
+            var policy = new ConversationStatusPolicy("synthetic-adapter", "synthetic-policy-v1",
+                Enum.GetValues<StatusField>().ToDictionary(field => field,
+                    field => TimeSpan.FromSeconds(field == StatusField.Presence ? 60 : 10)));
+            return new(lookup, expected, snapshot, policy);
+        }
+    }
+
+    private sealed class Provider : IDialogueWordingProvider
+    {
+        public readonly List<DialogueWordingRequest> Requests = [];
+        public string ProviderName => "synthetic-fallback-status";
+        public Task<DialogueWordingResult> GenerateAsync(DialogueWordingRequest request, CancellationToken token)
+        {
+            Requests.Add(request);
+            // The first draft is retained for direction trimming. The rewrite
+            // is refused before clearing that draft, so fallback uses draft one.
+            var text = Requests.Count == 1 ? "that npc was south of foreas base" : "I'm here for you if you need to talk";
+            return Task.FromResult(new DialogueWordingResult(request.RequestId, ProviderName, "fixture", text,
+                DialogueWordingCompletionStatus.Succeeded, TimeSpan.Zero, null, null, false,
+                DialogueProviderFailureClassification.None, request.GenerationPolicyVersion));
+        }
+    }
+
+    [Theory]
+    [InlineData("ffxi", "expired", false)] [InlineData("swtor", "expired", false)]
+    [InlineData("ffxi", "location", false)] [InlineData("swtor", "location", false)]
+    [InlineData("ffxi", "unchanged", true)] [InlineData("swtor", "unchanged", true)]
+    [InlineData("ffxi", "disabled", true)] [InlineData("swtor", "disabled", true)]
+    public async Task Retained_draft_rechecks_its_own_status_after_rewrite(string game, string change, bool accepted)
+    {
+        using var store = new NeuronetworkStore(":memory:");
+        var clock = new Clock();
+        var source = new Source(clock, change);
+        var provider = new Provider();
+        var service = new ConversationService(store, provider, clock)
+        {
+            ContextEnvironment = _ => game, StatusEnvironment = _ => change == "disabled" ? null : game,
+            ChatVoiceEnvironment = _ => null, RecentContextEnvironment = _ => null,
+            SharedStatusSource = source, CompanionExtractor = null, CompanionExtractorForGame = null,
+        };
+        var history = new[] { "Player: the same intentional line", "Player: the same intentional line" };
+        var reply = await service.CompanionReplyAsync(new CompanionLine
+        {
+            GameId = game, ServerInstanceId = "synthetic-instance", Persona = "Fixture", Speaker = "Player",
+            Text = "where is that npc?", Channel = "party", Shadow = true, History = history,
+            Facts = [new("quest_fixture", "Synthetic NPC: at Foreas Base")],
+            Bot = new ConversationHearer { ActorKey = "fixture", DisplayName = "Fixture" },
+        }, default);
+
+        Assert.Equal(2, provider.Requests.Count);
+        Assert.All(provider.Requests, request => Assert.Equal(history, request.ConversationContext!.History));
+        Assert.Contains(provider.Requests[1].TriggerFacts, fact => fact.Key == "rewrite" && fact.Value.Contains("south of", StringComparison.Ordinal));
+        Assert.Equal(change == "disabled" ? 0 : 5, source.Calls);
+        Assert.Equal(accepted, reply.Text is not null);
+        if (accepted)
+        {
+            Assert.Equal("that npc was by foreas base", reply.Text);
+            Assert.Contains("dropped the direction south of", reply.Note);
+        }
+        else Assert.Equal("shared status changed before fallback", reply.Note);
+
+        if (change == "expired")
+        {
+            Assert.Contains(service.StatusBindingFor(provider.Requests[0])!.View!.Fields,
+                field => field.Field == StatusField.Location && field.State == StatusKnowledge.Known);
+            Assert.Contains(service.StatusBindingFor(provider.Requests[1])!.View!.Fields,
+                field => field.Field == StatusField.Location && field.State == StatusKnowledge.Stale);
+        }
+        if (change == "location")
+        {
+            Assert.Contains(service.StatusBindingFor(provider.Requests[0])!.View!.Fields,
+                field => field.Field == StatusField.Location && field.Value == "Synthetic west entrance");
+            Assert.Contains(service.StatusBindingFor(provider.Requests[1])!.View!.Fields,
+                field => field.Field == StatusField.Location && field.Value == "Synthetic east entrance");
+        }
+    }
