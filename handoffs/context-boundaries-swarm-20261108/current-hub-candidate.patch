new file mode 100644
index 0000000000000000000000000000000000000000..2668b25136b49dbada40ac920563a213493f0ad9
--- /dev/null
+++ b/src/Dit.HumanBehavior.Neuronetwork/Conversation/ConversationStatusProjection.cs
@@ -0,0 +1,144 @@
+using System.Globalization;
+using System.Security.Cryptography;
+using System.Text;
+using System.Text.Json;
+using Dit.HumanBehavior.Contracts;
+
+namespace Dit.HumanBehavior.Neuronetwork.Conversation;
+
+// Offline candidate: no route or production producer registration. The service
+// integrates this read view only through its explicit, default-off source boundary.
+// A trusted adapter boundary must supply the identity, current cursor and source
+// policy. Values in chat, persona configuration and plans cannot supply them.
+public sealed record StatusBodyIdentity(string Game, string Realm, string Instance, string NativeActorId);
+public sealed record StatusExpectation(StatusBodyIdentity Body, string Epoch, long Sequence, bool NeedsSnapshot = false);
+public enum StatusOrigin { NativeAdapter, Conversation, Plan }
+public enum StatusField { Presence, Location, Activity, Party, Job, Level }
+public enum StatusKnowledge { Known, Stale, Unknown }
+public sealed record StatusFieldObservation(StatusField Field, string? Value, DateTimeOffset ObservedAtUtc, DateTimeOffset ValidUntilUtc);
+public sealed record StatusSnapshot(StatusBodyIdentity Body, string Epoch, long Sequence, string Source,
+    StatusOrigin Origin, bool Complete, DateTimeOffset ReceivedAtUtc, ValueList<StatusFieldObservation> Fields);
+public sealed record StatusFieldView(StatusField Field, StatusKnowledge State, string? Value, string Reason,
+    DateTimeOffset? ObservedAtUtc, DateTimeOffset? ValidUntilUtc);
+public sealed record ConversationStatusView(StatusBodyIdentity Body, string Epoch, long Sequence,
+    string? Source, string? RevisionSha256, string FreshnessPolicyVersion, DateTimeOffset ReadAtUtc, ValueList<StatusFieldView> Fields)
+{
+    // Only current, scoped observations can enter a reply's approved facts.
+    // Unknown/stale fields are separately visible; never rebrand their old value.
+    public ValueList<ConversationFact> ApprovedFacts => ValueList<ConversationFact>.From(Fields
+        .Where(f => f.State == StatusKnowledge.Known && f.Value is not null)
+        .Select(f => new ConversationFact("native_status_" + f.Field.ToString().ToLowerInvariant(), f.Value!)));
+}
+
+/// <summary>Caller-owned per-game expiry policy. No guessed universal lifetime.</summary>
+public sealed class ConversationStatusPolicy
+{
+    internal string Source { get; }
+    internal string Version { get; }
+    internal IReadOnlyDictionary<StatusField, TimeSpan> MaxAges { get; }
+    public ConversationStatusPolicy(string source, string version, IReadOnlyDictionary<StatusField, TimeSpan> maxAges)
+    {
+        if (string.IsNullOrWhiteSpace(source) || source.Length > 128 || source.Any(char.IsControl) ||
+            string.IsNullOrWhiteSpace(version) || version.Length > 128 || version.Any(char.IsControl) ||
+            maxAges.Count != Enum.GetValues<StatusField>().Length ||
+            Enum.GetValues<StatusField>().Any(f => !maxAges.TryGetValue(f, out var age) || age <= TimeSpan.Zero || age > TimeSpan.FromDays(1)))
+            throw new ArgumentException("An explicit bounded expiry policy is required for every supported field.");
+        Source = source;
+        Version = version;
+        MaxAges = new Dictionary<StatusField, TimeSpan>(maxAges);
+    }
+}
+
+/// <summary>
+/// A pure read projection for bot context and Admin consumers. It does not replace
+/// the existing native state store, authenticate a source, infer a new epoch, merge
+/// deltas, or grant a bot visibility of another body. The caller supplies the exact
+/// authorized identity and current store cursor from one atomic snapshot read.
+/// </summary>
+public static class ConversationStatusProjection
+{
+    public static ConversationStatusView Build(StatusExpectation expected, StatusSnapshot? snapshot,
+        ConversationStatusPolicy policy, DateTimeOffset now)
+    {
+        if (!ValidIdentity(expected.Body) || !Key(expected.Epoch) || expected.Sequence < 0 || now.Offset != TimeSpan.Zero)
+            throw new ArgumentException("Invalid trusted status expectation or read clock.");
+        var reason = UnavailableReason(expected, snapshot, policy, now);
+        if (reason is not null)
+            return new(expected.Body, expected.Epoch, expected.Sequence, null, null, policy.Version, now,
+                ValueList<StatusFieldView>.From(Enum.GetValues<StatusField>().Select(f => Unknown(f, reason))));
+
+        var frame = snapshot!;
+        var byField = frame.Fields.ToDictionary(f => f.Field);
+        var views = Enum.GetValues<StatusField>().Select(field =>
+        {
+            if (!byField.TryGetValue(field, out var input) || input.Value is null)
+                return Unknown(field, "not observed");
+            var maxAge = policy.MaxAges[field];
+            // Subtract instead of adding near DateTimeOffset.MaxValue.
+            var expired = now >= input.ValidUntilUtc || now - input.ObservedAtUtc >= maxAge;
+            var deadline = input.ValidUntilUtc - input.ObservedAtUtc > maxAge
+                ? input.ObservedAtUtc.Add(maxAge) : input.ValidUntilUtc;
+            return new StatusFieldView(field, expired ? StatusKnowledge.Stale : StatusKnowledge.Known,
+                expired ? null : input.Value, expired ? "expired observation" : "native observation", input.ObservedAtUtc, deadline);
+        }).ToArray();
+        var presence = views.Single(f => f.Field == StatusField.Presence);
+        // A body without confirmed current presence cannot supply current activity.
+        // Preserve field timestamps for inspection, but withhold their values.
+        if (presence.State != StatusKnowledge.Known || presence.Value != "online")
+        {
+            var why = presence.State == StatusKnowledge.Known ? "native disconnect" : "presence unconfirmed";
+            for (var i = 0; i < views.Length; i++)
+                if (views[i].Field != StatusField.Presence)
+                    views[i] = views[i] with { State = StatusKnowledge.Unknown, Value = null, Reason = why };
+        }
+        return new(expected.Body, expected.Epoch, expected.Sequence, frame.Source, Digest(frame), policy.Version, now,
+            ValueList<StatusFieldView>.From(views));
+    }
+
+    private static string? UnavailableReason(StatusExpectation expected, StatusSnapshot? frame,
+        ConversationStatusPolicy policy, DateTimeOffset now)
+    {
+        if (expected.NeedsSnapshot) return "sequence gap: snapshot required";
+        if (frame is null) return "snapshot unavailable";
+        if (frame.Body != expected.Body) return "body scope mismatch";
+        if (frame.Epoch != expected.Epoch) return "session epoch mismatch";
+        if (frame.Sequence != expected.Sequence) return "snapshot revision mismatch";
+        if (frame.Source != policy.Source || frame.Origin != StatusOrigin.NativeAdapter) return "untrusted status source";
+        if (!frame.Complete) return "incomplete snapshot";
+        if (frame.ReceivedAtUtc.Offset != TimeSpan.Zero || frame.ReceivedAtUtc > now || frame.Fields is null || frame.Fields.Count > 6)
+            return "invalid snapshot";
+        if (frame.Fields.Any(f => f is null || !Enum.IsDefined(f.Field)) ||
+            frame.Fields.Select(f => f.Field).Distinct().Count() != frame.Fields.Count)
+            return "invalid snapshot fields";
+        foreach (var field in frame.Fields)
+        {
+            if (field.ObservedAtUtc.Offset != TimeSpan.Zero || field.ValidUntilUtc.Offset != TimeSpan.Zero ||
+                field.ObservedAtUtc > frame.ReceivedAtUtc || field.ValidUntilUtc <= field.ObservedAtUtc ||
+                field.Value is not null && (string.IsNullOrWhiteSpace(field.Value) || field.Value.Length > 256 || field.Value.Any(char.IsControl)))
+                return "invalid field observation";
+            if (field.Field == StatusField.Presence && field.Value is not (null or "online" or "offline"))
+                return "invalid presence observation";
+        }
+        return null;
+    }
+
+    private static StatusFieldView Unknown(StatusField field, string reason) => new(field, StatusKnowledge.Unknown, null, reason, null, null);
+    private static bool Key(string? value) => !string.IsNullOrWhiteSpace(value) && value.Length <= 128 && !value.Any(char.IsControl);
+    private static bool ValidIdentity(StatusBodyIdentity? body) => body is not null && Key(body.Game) && Key(body.Realm) && Key(body.Instance) && Key(body.NativeActorId);
+    private static string Digest(StatusSnapshot frame)
+    {
+        // Explicit stable ordering; received time is transport metadata, not an
+        // observation revision. Duplicate receipt cannot extend field validity.
+        var canonical = JsonSerializer.Serialize(new
+        {
+            schema = "dit.status-projection-candidate.v1", frame.Body, frame.Epoch, frame.Sequence, frame.Source,
+            fields = frame.Fields.OrderBy(f => f.Field).Select(f => new
+            {
+                name = f.Field.ToString(), f.Value,
+                observed = f.ObservedAtUtc.ToString("O", CultureInfo.InvariantCulture),
+                validUntil = f.ValidUntilUtc.ToString("O", CultureInfo.InvariantCulture)
+            })
+        });
+        return Convert.ToHexStringLower(SHA256.HashData(Encoding.UTF8.GetBytes(canonical)));
+    }
+}
