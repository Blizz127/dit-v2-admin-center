+using Dit.HumanBehavior.Contracts;
+using Dit.HumanBehavior.DialogueWording;
+
+namespace Dit.HumanBehavior.Neuronetwork.Conversation;
+
+public sealed partial class ConversationService
+{
+    internal Func<string, string?> ContextEnvironment { get; set; } = System.Environment.GetEnvironmentVariable;
+
+    internal bool StructuredContextEnabled(string gameId) =>
+        (ContextEnvironment("DIT_CONVERSATION_CONTEXT_GAMES") ?? "")
+            .Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
+            .Any(game => string.Equals(game, gameId, StringComparison.OrdinalIgnoreCase));
+
+    private DialogueConversationContext? ConversationFor(string gameId, IReadOnlyList<string> history, string? current) =>
+        StructuredContextEnabled(gameId) ? new(ValueList<string>.From(history), current) : null;
+}
