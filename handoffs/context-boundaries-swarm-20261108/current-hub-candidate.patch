+    private static void AssertReceipt(DialogueWordingPromptTextContent prompt)
+    {
+        var receipt = prompt.ContextReceipt!;
+        Assert.Equal(prompt.SystemMessage.Length + prompt.UserMessage.Length, receipt.SerializedCharacters);
+        Assert.True(receipt.SerializedCharacters <= receipt.MaximumSerializedCharacters);
+        var encoded = prompt.SystemMessage.Length + ":" + prompt.SystemMessage + prompt.UserMessage.Length + ":" + prompt.UserMessage;
+        Assert.Equal(Convert.ToHexStringLower(SHA256.HashData(Encoding.UTF8.GetBytes(encoded))), receipt.PromptSha256);
+    }
+
+    private static DialogueWordingRequest Copy(DialogueWordingRequest r, DialogueConversationContext? context, ValueList<DialogueContextFact>? facts = null) => new(
+        r.IntentionId, r.Game, r.Actor, r.SemanticTopic, r.SemanticIntent, r.TriggerType, r.TriggerFacts, r.Channel, r.AudienceType,
+        r.PersonalitySummary, r.CommunicationStyle, r.RelevantMemories, r.RelationshipRole, r.RelationshipSummary, r.CurrentHighLevelActivity,
+        facts ?? r.ApprovedGameWorldFacts, r.MaximumOutputCharacters, r.MaximumOutputUtf8Bytes, r.Locale, r.GenerationPolicyVersion,
+        r.TemplateFamily, r.DeterministicFallbackText, r.FallbackPolicy, r.OutputConstraints, r.RequestedAtUtc, r.ExpiresAtUtc,
+        r.CorrelationId, r.CausationId, r.SharedEventMemorySummary, context);
