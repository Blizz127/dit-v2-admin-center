+using System.Collections.Concurrent;
+using System.Net;
+using System.Net.Http.Headers;
+using System.Text;
+using Dit.HumanBehavior.DialogueWording;
+using Dit.HumanBehavior.Neuronetwork.Client;
+using Dit.HumanBehavior.Neuronetwork.Conversation;
+using Dit.HumanBehavior.Neuronetwork.Hub;
+using Microsoft.AspNetCore.Builder;
+using Microsoft.AspNetCore.Hosting;
+using Microsoft.AspNetCore.Hosting.Server;
+using Microsoft.AspNetCore.Hosting.Server.Features;
+using Microsoft.Extensions.DependencyInjection;
+using Microsoft.Extensions.Logging;
+using Xunit;
+
+namespace Dit.HumanBehavior.Neuronetwork.Tests;
+
+[Collection("Producer context environment")]
+public sealed class ConversationStatusIngressTests : IAsyncLifetime
+{
+    private readonly TempDirectory _temp = new();
+    private WebApplication? _app;
+    private HubRuntime? _runtime;
+    private string _adapter = "", _admin = "", _other = "";
+    private Uri _base = new("http://127.0.0.1/");
+    private readonly SpySource _source = new();
+    private readonly Provider _provider = new();
+    private sealed class SpySource : IConversationStatusSource
+    {
+        public List<ConversationStatusLookup> Reads = [];
+        public ConversationStatusCapture? Capture(ConversationStatusLookup lookup) { Reads.Add(lookup); return null; }
+    }
+    private sealed class Provider : IDialogueWordingProvider
+    {
+        public string ProviderName => "offline-status-ingress";
+        public readonly ConcurrentQueue<DialogueWordingRequest> Requests = new();
+        public Task<DialogueWordingResult> GenerateAsync(DialogueWordingRequest request, CancellationToken ct)
+        {
+            Requests.Enqueue(request);
+            return Task.FromResult(new DialogueWordingResult(request.RequestId, ProviderName, "fixture", null,
+                DialogueWordingCompletionStatus.Unavailable, TimeSpan.Zero, null, null, false,
+                DialogueProviderFailureClassification.Availability, request.GenerationPolicyVersion));
+        }
+    }
+    public async Task InitializeAsync()
+    {
+        var config = new HubConfig { DataDirectory = _temp.Path, TokenFile = Path.Combine(_temp.Path, "tokens.json"),
+            LogArchiveDirectory = Path.Combine(_temp.Path, "logs") };
+        _adapter = HubTokens.Add(config.TokenFile, "synthetic-adapter", HubRole.Adapter, "ffxi");
+        _admin = HubTokens.Add(config.TokenFile, "synthetic-admin", HubRole.Admin, null);
+        _other = HubTokens.Add(config.TokenFile, "other-game", HubRole.Adapter, "swtor");
+        _runtime = new HubRuntime(config, conversationProvider: _provider);
+        // No asynchronous memory-model route may escape this synthetic localhost fixture.
+        _runtime.Conversation.CompanionExtractor = null;
+        _runtime.Conversation.CompanionExtractorForGame = null;
+        Assert.Null(_runtime.Conversation.SharedStatusSource);
+        _runtime.Conversation.SharedStatusSource = _source;
+        _runtime.Conversation.StatusEnvironment = _ => "ffxi";
+        _runtime.Conversation.ContextEnvironment = _ => "ffxi";
+        _runtime.Conversation.Group.Environment = _ => null;
+        _runtime.Conversation.Group.SingleModelReplyForGame = _ => true;
+        // This fixed synthetic host has no reloadable configuration. Avoid consuming
+        // shared inotify instances; do not raise or bypass the host's resource limit.
+        var builder = WebApplication.CreateSlimBuilder(new WebApplicationOptions
+        { Args = ["--hostBuilder:reloadConfigOnChange=false"], ContentRootPath = _temp.Path });
+        builder.WebHost.UseUrls("http://127.0.0.1:0"); builder.Logging.ClearProviders();
+        _app = builder.Build(); HubApi.Map(_app, _runtime, HubTokens.Load(config.TokenFile));
+        await _app.StartAsync();
+        _base = new Uri(_app.Services.GetRequiredService<IServer>().Features.Get<IServerAddressesFeature>()!.Addresses.First() + "/");
+    }
+    public async Task DisposeAsync()
+    {
+        if (_app is not null) { await _app.StopAsync(); await _app.DisposeAsync(); }
+        _runtime?.Dispose(); _temp.Dispose();
+    }
+    private async Task<HttpStatusCode> Post(string route, string? token)
+    {
+        // A caller name supplied in JSON is deliberately hostile test input.
+        var common = "\"gameId\":\"ffxi\",\"serverInstanceId\":\"synthetic-instance\",\"nativeScope\":{\"gameId\":\"ffxi\",\"caller\":\"forged\",\"serverInstanceId\":\"synthetic-instance\"}";
+        var bot = "{\"actorKey\":\"fixture\",\"displayName\":\"Fixture\",\"addressed\":true}";
+        var body = route == "event"
+            ? "{" + common + ",\"bot\":" + bot + ",\"kind\":\"level\",\"detail\":\"reached level 2\",\"nearbyPlayers\":[\"Player\"]}"
+            : "{" + common + ",\"lineId\":\"synthetic-line\",\"scope\":\"synthetic-party\",\"channel\":\"tell\",\"speaker\":{\"name\":\"Player\",\"isPlayer\":true},\"text\":\"Fixture, are you around?\",\"hearers\":[" + bot + "],\"private\":true,\"shadow\":true,\"mode\":\"shadow\",\"guarantee\":true}";
+        using var client = new HttpClient { BaseAddress = _base, Timeout = TimeSpan.FromSeconds(10) };
+        if (token is not null) client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
+        using var response = await client.PostAsync("v1/games/ffxi/conversation/" + route, new StringContent(body, Encoding.UTF8, "application/json"));
+        return response.StatusCode;
+    }
+
+    [Theory]
+    [InlineData("reply", true)] [InlineData("event", true)] [InlineData("group", true)]
+    [InlineData("reply", false)] [InlineData("event", false)] [InlineData("group", false)]
+    public async Task Only_authenticated_owning_adapter_supplies_native_caller(string route, bool adapter)
+    {
+        Assert.Equal(HttpStatusCode.OK, await Post(route, adapter ? _adapter : _admin));
+        Assert.NotEmpty(_source.Reads);
+        Assert.All(_source.Reads, read =>
+        {
+            Assert.Equal("fixture", read.ActorKey);
+            if (adapter) { Assert.Equal("synthetic-adapter", read.NativeScope!.Value.Caller); Assert.Equal(read.ServerInstance, read.NativeScope.Value.ServerInstanceId); }
+            else Assert.Null(read.NativeScope);
+        });
+    }
+
+    [Fact]
+    public async Task Denied_callers_and_disabled_status_do_not_read_status()
+    {
+        foreach (var route in new[] { "reply", "event", "group" })
+        {
+            Assert.Equal(HttpStatusCode.Forbidden, await Post(route, null));
+            Assert.Equal(HttpStatusCode.Forbidden, await Post(route, _other));
+        }
+        Assert.Empty(_source.Reads);
+        _runtime!.Conversation.StatusEnvironment = _ => null;
+        Assert.Equal(HttpStatusCode.OK, await Post("reply", _adapter));
+        Assert.Empty(_source.Reads);
+    }
+
+    [Theory]
+    [InlineData("ffxi", 12)] [InlineData("swtor", 12)]
+    [InlineData("ffxi", 32)] [InlineData("swtor", 32)]
+    public async Task Shared_client_group_history_survives_authenticated_http_and_prompt_building(string game, int turns)
+    {
+        var env = new Dictionary<string, string?>
+        {
+            ["DIT_NEURONETWORK_CONSULT_TOKEN_DIRECTORY"] = _temp.Path,
+            ["DIT_" + game.ToUpperInvariant() + "_HUB_CONVERSATION"] = "only",
+            ["DIT_" + game.ToUpperInvariant() + "_GROUP"] = "live",
+            ["DIT_" + game.ToUpperInvariant() + "_GROUP_ACTORS"] = "",
+        };
+        var before = env.Keys.ToDictionary(k => k, Environment.GetEnvironmentVariable);
+        try
+        {
+            foreach (var (key, value) in env) Environment.SetEnvironmentVariable(key, value);
+            File.WriteAllText(Path.Combine(_temp.Path, game + ".token"), game == "ffxi" ? _adapter : _other);
+            _runtime!.Conversation.ContextEnvironment = _ => game;
+            _runtime.Conversation.StatusEnvironment = _ => game;
+            var input = ConversationProducerContextTests.Request(game, turns, current: true);
+            var reports = new List<string>();
+            using var http = new HttpClient { Timeout = TimeSpan.FromSeconds(10) };
+            var client = new NeuronetConversationClient(game, http, _base.ToString().TrimEnd('/'));
+            using var producer = NeuronetConversationWordingProvider.HubOnly(client, "fixture-instance", reports.Add);
+            producer.ContextEnvironment = _ => game;
+            await producer.GenerateAsync(input, default);
+            // HubRuntime also warms the provider asynchronously. Exclude only that
+            // exact throwaway identity; unexpected requests still fail Assert.Single.
+            var request = Assert.Single(_provider.Requests.ToArray(), r =>
+                !(r.Game.GameId == "warhammer_online" && r.Game.ServerInstanceId == "warmup" && r.Actor.ActorKey == "warmup"));
+            Assert.Equal(game, request.Game.GameId);
+            Assert.Equal("fixture-instance", request.Game.ServerInstanceId);
+            Assert.Equal(input.Actor.ActorKey, request.Actor.ActorKey);
+            var retained = input.ConversationContext!.History.TakeLast(16).ToArray();
+            Assert.Equal(retained, request.ConversationContext!.History);
+            Assert.Equal(input.ConversationContext.CurrentMessage, request.ConversationContext.CurrentMessage);
+            var prompt = DialogueWordingPromptText.Build(request);
+            Assert.Equal(retained.Length, prompt.ContextReceipt!.SuppliedHistoryTurns);
+            Assert.Equal(retained.Length, prompt.ContextReceipt.IncludedHistoryTurns);
+            Assert.Equal(0, prompt.ContextReceipt.OmittedHistoryTurns);
+            var section = prompt.UserMessage.Split("UNTRUSTED RECENT CONVERSATION\n")[1].Split("\n\n")[0].Split('\n');
+            Assert.Equal(retained.Select(turn => "- " + turn), section.Skip(1).Take(retained.Length));
+            Assert.Contains($"- LATEST LINE, the one you are answering: {input.ConversationContext.CurrentMessage}", section);
+            Assert.Contains(reports, report => report.Contains($"history supplied={turns}, prepared={retained.Length}, omitted={turns - retained.Length}"));
+            Assert.NotEmpty(_source.Reads);
+            Assert.All(_source.Reads, read =>
+            {
+                Assert.Equal(game, read.Game);
+                Assert.Equal(game == "ffxi" ? "synthetic-adapter" : "other-game", read.NativeScope!.Value.Caller);
+            });
+            var binding = _runtime.Conversation.StatusBindingFor(request);
+            Assert.Equal("source unavailable", binding!.State);
+            Assert.Null(binding.View);
+            Assert.DoesNotContain(request.ApprovedGameWorldFacts, fact => fact.Key == "native_status_location");
+        }
+        finally { foreach (var (key, value) in before) Environment.SetEnvironmentVariable(key, value); }
+    }
+}
