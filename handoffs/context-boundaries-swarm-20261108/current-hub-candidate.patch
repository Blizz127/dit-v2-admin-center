--- /dev/null
+++ b/tests/Dit.HumanBehavior.Neuronetwork.Tests/FfxiConversationStatusSourceTests.cs
@@ -0,0 +1,205 @@
+using Dit.HumanBehavior.DialogueWording;
+using Dit.HumanBehavior.Neuronetwork.Conversation;
+using Dit.HumanBehavior.Neuronetwork.Interaction;
+using Dit.HumanBehavior.Neuronetwork.Knowledge;
+using Dit.HumanBehavior.Neuronetwork.Store;
+using Xunit;
+
+namespace Dit.HumanBehavior.Neuronetwork.Tests;
+
+public sealed class FfxiConversationStatusSourceTests
+{
+    private static readonly DateTimeOffset At = InteractionContractTests.T0;
+    private static readonly InteractionScope Scope = InteractionContractTests.Scope;
+    private static readonly StatusBodyIdentity Body = new("ffxi", "synthetic-realm", Scope.ServerInstanceId, "synthetic-native-id");
+    private sealed class Clock : TimeProvider { public DateTimeOffset Now = At; public override DateTimeOffset GetUtcNow() => Now; }
+    private static Dictionary<(InteractionScope, string), StatusBodyIdentity> Registry() => new() { [(Scope, "kaelin")] = Body };
+    private static ConversationStatusLookup Lookup() => new("ffxi", Scope.ServerInstanceId, "kaelin") { NativeScope = Scope };
+    private static FfxiConversationStatusSource Source(FfxiInteraction interaction, string? flag = "1") => new(interaction, Registry(), _ => flag);
+    private static ObservedState Snapshot(long seq = 1) => InteractionContractTests.Snap(seq, At) with
+    { Zone = "Synthetic zone", Job = "WAR", Level = 20, AssignedPastime = "crafting", Phase = "rest" };
+    private static void Ingest(FfxiInteraction interaction, ObservedState snapshot) => interaction.Ingest(Scope, new() { Snapshots = [snapshot] }, []);
+
+    [Fact]
+    public void Reads_actual_store_revision_without_inventing_presence_or_refreshing_clocks()
+    {
+        var clock = new Clock { Now = At.AddSeconds(1) };
+        var interaction = new FfxiInteraction(clock); Ingest(interaction, Snapshot());
+        var source = Source(interaction);
+        var captured = Assert.IsType<ConversationStatusCapture>(source.Capture(Lookup()));
+        Assert.Equal(Body, captured.Expectation.Body);
+        Assert.Equal(1, captured.Expectation.Sequence);
+        Assert.False(captured.Expectation.NeedsSnapshot);
+        Assert.Equal(At.AddSeconds(1), captured.Snapshot!.ReceivedAtUtc);
+        Assert.All(captured.Snapshot.Fields, f => Assert.Equal(At, f.ObservedAtUtc));
+        Assert.Contains(captured.Snapshot.Fields, f => f.Field == StatusField.Activity && f.Value == "resting");
+        Assert.DoesNotContain(captured.Snapshot.Fields, f => f.Field == StatusField.Presence || f.Value == "crafting");
+        var view = ConversationStatusProjection.Build(captured.Expectation, captured.Snapshot, captured.Policy, clock.Now);
+        Assert.Empty(view.ApprovedFacts);
+        Assert.All(view.Fields, f => { Assert.Equal(StatusKnowledge.Unknown, f.State); Assert.Null(f.Value); });
+        clock.Now = At.AddMinutes(5);
+        var later = source.Capture(Lookup())!;
+        Assert.Equal(captured.Snapshot, later.Snapshot);
+        Assert.Equal(captured.Snapshot.ReceivedAtUtc, later.Snapshot!.ReceivedAtUtc);
+        Assert.Empty(interaction.Ledger.PendingEntries(Scope, ["kaelin"], clock.Now));
+    }
+
+    [Theory]
+    [InlineData("missing-scope")] [InlineData("other-caller")] [InlineData("other-instance")]
+    [InlineData("other-actor")] [InlineData("swtor")]
+    public void Untrusted_or_unmapped_lookup_cannot_read_a_native_body(string variant)
+    {
+        var interaction = new FfxiInteraction(new Clock()); Ingest(interaction, Snapshot());
+        var lookup = variant switch
+        {
+            "missing-scope" => Lookup() with { NativeScope = null },
+            "other-caller" => Lookup() with { NativeScope = Scope with { Caller = "another-adapter" } },
+            "other-instance" => Lookup() with { ServerInstance = "another-instance" },
+            "other-actor" => Lookup() with { ActorKey = "another-bot" },
+            _ => Lookup() with { Game = "swtor", NativeScope = Scope with { GameId = "swtor" } },
+        };
+        Assert.Null(Source(interaction).Capture(lookup));
+    }
+
+    [Fact]
+    public void Contract_off_missing_snapshot_and_empty_mapping_are_unavailable()
+    {
+        var interaction = new FfxiInteraction(new Clock());
+        Assert.Null(Source(interaction).Capture(Lookup()));
+        Ingest(interaction, Snapshot());
+        Assert.Null(Source(interaction, null).Capture(Lookup()));
+        Assert.Null(new FfxiConversationStatusSource(interaction, new Dictionary<(InteractionScope, string), StatusBodyIdentity>(), _ => "1").Capture(Lookup()));
+    }
+
+    [Fact]
+    public void Registry_is_copied_and_wrong_game_or_instance_is_rejected()
+    {
+        var interaction = new FfxiInteraction(new Clock()); Ingest(interaction, Snapshot());
+        var registry = Registry(); var source = new FfxiConversationStatusSource(interaction, registry, _ => "1");
+        registry.Clear();
+        Assert.NotNull(source.Capture(Lookup()));
+        foreach (var body in new[] { Body with { Game = "swtor" }, Body with { Instance = "wrong" }, Body with { NativeActorId = "" } })
+            Assert.Throws<ArgumentException>(() => new FfxiConversationStatusSource(interaction,
+                new Dictionary<(InteractionScope, string), StatusBodyIdentity> { [(Scope, "kaelin")] = body }, _ => "1"));
+    }
+
+    [Fact]
+    public void Newer_native_report_requires_snapshot_and_does_not_refresh_snapshot_time()
+    {
+        var clock = new Clock(); var interaction = new FfxiInteraction(clock); Ingest(interaction, Snapshot());
+        clock.Now = At.AddSeconds(2);
+        interaction.Ingest(Scope, new() { Reports = [InteractionContractTests.Report("n:fixture:follow", 2, "executing", clock.Now,
+            follow: new ObservedFollow("Testplayer", ActionId: "n:fixture:follow"), kind: "follow")] }, []);
+        Assert.Equal(2, interaction.Ledger.HighWater(Scope, "kaelin", "e-7f3a"));
+        var captured = Source(interaction).Capture(Lookup())!;
+        Assert.True(captured.Expectation.NeedsSnapshot);
+        Assert.Equal(At, captured.Snapshot!.ReceivedAtUtc);
+        var view = ConversationStatusProjection.Build(captured.Expectation, captured.Snapshot, captured.Policy, clock.Now);
+        Assert.All(view.Fields, f => Assert.Equal("sequence gap: snapshot required", f.Reason));
+        Ingest(interaction, Snapshot(3) with { ObservedAtUtc = clock.Now });
+        Assert.False(Source(interaction).Capture(Lookup())!.Expectation.NeedsSnapshot);
+    }
+
+    [Fact]
+    public void Reconnect_retires_old_epoch_and_duplicate_does_not_refresh_receipt()
+    {
+        var clock = new Clock(); var interaction = new FfxiInteraction(clock); Ingest(interaction, Snapshot());
+        clock.Now = At.AddSeconds(2); Ingest(interaction, Snapshot());
+        Assert.Equal(At, Source(interaction).Capture(Lookup())!.Snapshot!.ReceivedAtUtc);
+        Ingest(interaction, Snapshot() with { Epoch = "new-session", ObservedAtUtc = clock.Now });
+        var current = Source(interaction).Capture(Lookup())!;
+        Assert.Equal("new-session", current.Expectation.Epoch);
+        Assert.Equal(clock.Now, current.Snapshot!.ReceivedAtUtc);
+        clock.Now = At.AddSeconds(3); Ingest(interaction, Snapshot(9));
+        var after = Source(interaction).Capture(Lookup())!;
+        Assert.Equal(current.Expectation, after.Expectation);
+        Assert.Equal(current.Snapshot, after.Snapshot);
+    }
+
+    [Fact]
+    public void Native_timestamp_ahead_of_receive_clock_is_not_relabelled_as_current()
+    {
+        var interaction = new FfxiInteraction(new Clock());
+        Ingest(interaction, Snapshot() with { ObservedAtUtc = At.AddSeconds(1) });
+        Assert.NotNull(interaction.States.Latest(Scope, "kaelin")); // existing store permits bounded skew
+        Assert.Null(Source(interaction).Capture(Lookup()));
+    }
+
+    [Fact]
+    public async Task Concurrent_ingress_keeps_snapshot_fields_and_revision_together()
+    {
+        var interaction = new FfxiInteraction(new Clock());
+        Ingest(interaction, Snapshot() with { Zone = "fixture-1" });
+        var source = Source(interaction);
+        using var start = new ManualResetEventSlim();
+        var writer = Task.Run(() =>
+        {
+            Assert.True(start.Wait(TimeSpan.FromSeconds(5)));
+            for (var seq = 2; seq <= 200; seq++) Ingest(interaction, Snapshot(seq) with { Zone = "fixture-" + seq });
+        });
+        var reader = Task.Run(() =>
+        {
+            Assert.True(start.Wait(TimeSpan.FromSeconds(5)));
+            for (var i = 0; i < 200; i++)
+            {
+                var capture = source.Capture(Lookup())!;
+                Assert.False(capture.Expectation.NeedsSnapshot);
+                Assert.Equal(capture.Expectation.Sequence, capture.Snapshot!.Sequence);
+                Assert.Equal("fixture-" + capture.Expectation.Sequence,
+                    capture.Snapshot.Fields.Single(f => f.Field == StatusField.Location).Value);
+            }
+        });
+        start.Set(); await Task.WhenAll(writer, reader).WaitAsync(TimeSpan.FromSeconds(10));
+        Assert.Equal(200, source.Capture(Lookup())!.Expectation.Sequence);
+    }
+
+    [Theory]
+    [InlineData("companion")] [InlineData("heard")] [InlineData("event")]
+    public void Caller_scope_cannot_be_forged_in_json(string path)
+    {
+        var scope = "\"nativeScope\":{\"gameId\":\"ffxi\",\"caller\":\"consult-ffxi\",\"serverInstanceId\":\"phase4gb\"}";
+        var common = "\"gameId\":\"ffxi\",\"serverInstanceId\":\"phase4gb\"," + scope;
+        var bot = "{\"actorKey\":\"kaelin\",\"displayName\":\"Kaelin\"}";
+        if (path == "companion") Assert.Null(NeuronetworkJson.Deserialize<CompanionLine>("{" + common + ",\"bot\":" + bot + ",\"persona\":\"Kaelin\",\"speaker\":\"Fixture\",\"text\":\"hi\",\"channel\":\"tell\"}")!.NativeScope);
+        if (path == "heard") Assert.Null(NeuronetworkJson.Deserialize<ConversationHeard>("{" + common + ",\"lineId\":\"fixture\",\"speaker\":{\"name\":\"Fixture\",\"isPlayer\":true},\"text\":\"hi\",\"channel\":\"tell\",\"hearers\":[]}")!.NativeScope);
+        if (path == "event") Assert.Null(NeuronetworkJson.Deserialize<ConversationEvent>("{" + common + ",\"bot\":" + bot + ",\"kind\":\"idle\",\"detail\":\"hi\"}")!.NativeScope);
+        Assert.DoesNotContain("nativeScope", NeuronetworkJson.Serialize(Lookup()), StringComparison.OrdinalIgnoreCase);
+    }
+
+    [Theory]
+    [InlineData("ffxi")] [InlineData("swtor")]
+    public async Task Enabled_reply_uses_actual_source_and_withholds_legacy_status(string game)
+    {
+        using var store = new NeuronetworkStore(":memory:");
+        var provider = new CaptureProvider(); var clock = new Clock();
+        var service = new ConversationService(store, provider, clock) { QuickReplies = false, KnowledgeAnswers = false,
+            StatusEnvironment = _ => "ffxi,swtor", ContextEnvironment = _ => "ffxi,swtor" };
+        Ingest(service.Group.Interaction, Snapshot());
+        service.SharedStatusSource = Source(service.Group.Interaction);
+        await service.WordIntentAsync(game, Scope.ServerInstanceId, new() { ActorKey = "kaelin", DisplayName = "Kaelin",
+            Situation = "Old status poison", Facts = [new("place", "Old place poison")] }, "Say something brief", "party",
+            Enumerable.Range(0, 12).Select(n => "Fixture: turn " + n).ToArray(), "Old zone poison", 120, default,
+            nativeScope: Scope with { GameId = game });
+        var request = Assert.Single(provider.Requests);
+        var bound = service.StatusBindingFor(request)!;
+        Assert.Equal(Scope with { GameId = game }, bound.Lookup.NativeScope);
+        Assert.Equal(game == "ffxi" ? "snapshot projected" : "source unavailable", bound.State);
+        Assert.DoesNotContain(request.ApprovedGameWorldFacts, f => f.Key is "native_status_activity" or "native_status_location");
+        var prompt = DialogueWordingPromptText.Build(request);
+        Assert.DoesNotContain("poison", prompt.UserMessage);
+        Assert.Equal(12, prompt.ContextReceipt!.IncludedHistoryTurns);
+    }
+
+    private sealed class CaptureProvider : IDialogueWordingProvider
+    {
+        public string ProviderName => "offline-fixture";
+        public List<DialogueWordingRequest> Requests = [];
+        public Task<DialogueWordingResult> GenerateAsync(DialogueWordingRequest request, CancellationToken token)
+        {
+            Requests.Add(request);
+            return Task.FromResult(new DialogueWordingResult(request.RequestId, ProviderName, "fixture", null,
+                DialogueWordingCompletionStatus.Unavailable, TimeSpan.Zero, null, null, false,
+                DialogueProviderFailureClassification.Availability, request.GenerationPolicyVersion));
+        }
+    }
+}
diff --git a/tests/Dit.HumanBehavior.Neuronetwork.Tests/PreparedActionMemoryTests.cs b/tests/Dit.HumanBehavior.Neuronetwork.Tests/PreparedActionMemoryTests.cs
new file mode 100644
index 0000000000000000000000000000000000000000..1091daef896a4cab9baae362ba8812121d23f04d
--- /dev/null
+++ b/tests/Dit.HumanBehavior.Neuronetwork.Tests/PreparedActionMemoryTests.cs
@@ -0,0 +1,168 @@
+using System.Text.Json;
+using Dit.HumanBehavior.DialogueWording;
+using Dit.HumanBehavior.Neuronetwork.Conversation;
+using Dit.HumanBehavior.Neuronetwork.Goals;
+using Dit.HumanBehavior.Neuronetwork.Store;
+using Xunit;
+
+namespace Dit.HumanBehavior.Neuronetwork.Tests;
+
+public sealed class PreparedActionMemoryTests
+{
+    private static readonly DateTimeOffset Start = new(2030, 1, 1, 0, 0, 0, TimeSpan.Zero);
+    private static readonly string[] Observed =
+    [
+        "PlayerFixture: an earlier question",
+        "Fixture: a supplied observed line",
+        "PlayerFixture: the same intentional line",
+        "PlayerFixture: the same intentional line",
+    ];
+
+    private sealed class Clock : TimeProvider
+    {
+        public DateTimeOffset Now = Start;
+        public override DateTimeOffset GetUtcNow() => Now;
+    }
+
+    private sealed class Provider(params string[] replies) : IDialogueWordingProvider
+    {
+        public readonly List<DialogueWordingRequest> Requests = [];
+        public string ProviderName => "synthetic-prepared-action-memory";
+        public Task<DialogueWordingResult> GenerateAsync(DialogueWordingRequest request, CancellationToken token)
+        {
+            Requests.Add(request);
+            return Task.FromResult(new DialogueWordingResult(request.RequestId, ProviderName, "fake",
+                replies[Math.Min(Requests.Count - 1, replies.Length - 1)],
+                DialogueWordingCompletionStatus.Succeeded, TimeSpan.Zero, null, null, true,
+                DialogueProviderFailureClassification.None, request.GenerationPolicyVersion));
+        }
+    }
+
+    private static ConversationService Service(NeuronetworkStore store, Provider provider, Clock clock, string game, bool selected) =>
+        new(store, provider, clock)
+        {
+            ContextEnvironment = _ => selected ? game : null,
+            StatusEnvironment = _ => null, ChatVoiceEnvironment = _ => null,
+            QuickReplies = false, KnowledgeAnswers = false,
+        };
+
+    private static ConversationHeard Heard(string game, string id, string text) => new()
+    {
+        GameId = game, ServerInstanceId = "synthetic-instance", LineId = id,
+        Channel = "party", Speaker = new ConversationSpeaker("PlayerFixture", true),
+        Text = text, OccurredAtUtc = Start, AcceptsCommands = true,
+        Hearers = [new ConversationHearer { ActorKey = "fixture-bot", DisplayName = "Fixture", Addressed = true, InPartyWithSpeaker = true }],
+        History = Observed,
+    };
+
+    [Theory]
+    [InlineData("ffxi", true, false)] [InlineData("swtor", true, false)]
+    [InlineData("ffxi", false, false)] [InlineData("swtor", false, false)]
+    [InlineData("ffxi", true, true)] [InlineData("swtor", true, true)]
+    [InlineData("ffxi", false, true)] [InlineData("swtor", false, true)]
+    public async Task Prepared_command_is_remembered_as_a_request_without_native_completion(string game, bool selected, bool fromCanary)
+    {
+        using var store = new NeuronetworkStore(":memory:");
+        var clock = new Clock();
+        var provider = new Provider("unused command wording", "maybe tomorrow");
+        var service = Service(store, provider, clock, game, selected);
+        // This test catalog asserts no native capability; no body or goal executor is installed.
+        var catalog = new CommandCatalog(game,
+            [new BotCommand("stay", "Synthetic fixture request", [new("seconds", "int", "Synthetic duration")], "synthetic-only")],
+            "Offline memory test only");
+        var command = JsonSerializer.SerializeToElement(new { command = "stay", args = new { seconds = 7 }, bots = new[] { "Fixture" }, reply = "on it" });
+        var ordinaryCalls = 0;
+        var routedCalls = 0;
+        service.Interpreter = new CommandInterpreter(_ => catalog, (_, _, _) =>
+        {
+            ordinaryCalls++;
+            return Task.FromResult((command, "synthetic-command"));
+        })
+        {
+            Routed = fromCanary ? (_, _, _, _) =>
+            {
+                routedCalls++;
+                return Task.FromResult<(JsonElement Json, string Provider)?>((command, "synthetic-canary-route"));
+            } : null,
+        };
+        service.Memory.Note(game, "fixture-bot", "A supplied earlier observation", Start.AddSeconds(-1));
+        var heard = Heard(game, "synthetic-command", "stay here");
+
+        var decision = Assert.Single((await service.ReplyAsync(heard, default)).Decisions);
+        Assert.Equal("command", decision.Kind);
+        Assert.Equal("stay", decision.Command);
+        Assert.Equal(7, decision.Arguments!.Value.GetProperty("seconds").GetInt32());
+        Assert.Equal(new[] { "Fixture" }, decision.Bots);
+        Assert.Equal("on it", decision.Text);
+        Assert.Equal("command", decision.Origin);
+        Assert.Equal(fromCanary ? 0 : 1, ordinaryCalls);
+        Assert.Equal(fromCanary ? 1 : 0, routedCalls);
+        Assert.Single(provider.Requests); // Parallel wording was prepared and discarded.
+        var requestOnly = selected || fromCanary;
+        var expectedMemory = "PlayerFixture told us \"stay here\"; " +
+            (requestOnly ? "requested stay; completion unconfirmed" : "I did stay");
+        var journal = service.Memory.Get(game, "fixture-bot")!.Journal;
+        Assert.Equal(2, journal.Count);
+        Assert.Equal(expectedMemory, journal.Last().Text);
+        Assert.Contains(journal, entry => entry.Text == "A supplied earlier observation");
+
+        // Returning the prepared command still reserves its line without executing or completing it.
+        Assert.Equal("silence", Assert.Single((await service.ReplyAsync(heard, default)).Decisions).Kind);
+        Assert.Single(provider.Requests);
+        Assert.Equal(1, ordinaryCalls + routedCalls);
+        Assert.Equal(2, service.Memory.Get(game, "fixture-bot")!.Journal.Count);
+
+        clock.Now = Start.AddSeconds(31);
+        var nextHeard = Heard(game, "synthetic-next", "what about tomorrow?") with { OccurredAtUtc = clock.Now };
+        var nextDecision = Assert.Single((await service.ReplyAsync(nextHeard, default)).Decisions);
+        Assert.Equal("say", nextDecision.Kind);
+        Assert.Equal("maybe tomorrow", nextDecision.Text);
+        Assert.Equal(2, provider.Requests.Count);
+        Assert.Equal(1, ordinaryCalls + routedCalls);
+        var next = provider.Requests[1];
+        Assert.Contains(next.RelevantMemories, text => text.Contains(expectedMemory, StringComparison.Ordinal));
+        Assert.Contains(next.RelevantMemories, text => text.Contains("A supplied earlier observation", StringComparison.Ordinal));
+        Assert.Equal(!requestOnly, next.RelevantMemories.Any(text => text.Contains("I did stay", StringComparison.Ordinal)));
+        Assert.DoesNotContain(next.RelevantMemories, text => text.Contains("unused command wording", StringComparison.Ordinal));
+        if (selected)
+        {
+            Assert.Equal(Observed, next.ConversationContext!.History);
+            Assert.Equal(nextHeard.Text, next.ConversationContext.CurrentMessage);
+        }
+        else Assert.Null(next.ConversationContext);
+        if (requestOnly)
+            Assert.DoesNotContain("I did stay", DialogueWordingPromptText.Build(next, game).UserMessage);
+    }
+
+    [Theory]
+    [InlineData("ffxi", true)] [InlineData("swtor", true)]
+    [InlineData("ffxi", false)] [InlineData("swtor", false)]
+    public async Task Requested_emote_returns_an_instruction_without_booking_performed_action_memory(string game, bool selected)
+    {
+        using var store = new NeuronetworkStore(":memory:");
+        var clock = new Clock();
+        var provider = new Provider("maybe tomorrow");
+        var service = Service(store, provider, clock, game, selected);
+        service.Memory.Note(game, "fixture-bot", "A supplied earlier observation", Start.AddSeconds(-1));
+        var heard = Heard(game, "synthetic-emote", "please wave") with { Emotes = ["wave"] };
+
+        var decision = Assert.Single((await service.ReplyAsync(heard, default)).Decisions);
+        Assert.Equal("emote", decision.Kind);
+        Assert.Equal("emote", decision.Channel);
+        Assert.Equal("wave", decision.Text);
+        Assert.Empty(provider.Requests);
+        Assert.Equal("A supplied earlier observation", Assert.Single(service.Memory.Get(game, "fixture-bot")!.Journal).Text);
+        Assert.Equal("silence", Assert.Single((await service.ReplyAsync(heard, default)).Decisions).Kind);
+        Assert.Empty(provider.Requests);
+
+        clock.Now = Start.AddSeconds(31);
+        var nextDecision = Assert.Single((await service.ReplyAsync(
+            Heard(game, "synthetic-next", "what about tomorrow?") with { OccurredAtUtc = clock.Now }, default)).Decisions);
+        Assert.Equal("say", nextDecision.Kind);
+        var next = Assert.Single(provider.Requests);
+        Assert.Contains(next.RelevantMemories, text => text.Contains("A supplied earlier observation", StringComparison.Ordinal));
+        Assert.DoesNotContain(next.RelevantMemories, text => text.Contains("did /wave", StringComparison.Ordinal));
+        Assert.DoesNotContain("did /wave", DialogueWordingPromptText.Build(next, game).UserMessage);
+        Assert.DoesNotContain(service.Memory.Get(game, "fixture-bot")!.Journal, entry => entry.Text.Contains("did /wave", StringComparison.Ordinal));
+    }
+}
