diff --git a/tests/Dit.HumanBehavior.Neuronetwork.Tests/ProducerContextBoundaryTests.cs b/tests/Dit.HumanBehavior.Neuronetwork.Tests/ProducerContextBoundaryTests.cs
new file mode 100644
index 0000000000000000000000000000000000000000..a8d0046ba7e3ecc91ddfc55f2d4cb67565f84512
--- /dev/null
+++ b/tests/Dit.HumanBehavior.Neuronetwork.Tests/ProducerContextBoundaryTests.cs
@@ -0,0 +1,172 @@
+using System.Net;
+using System.Text;
+using System.Text.Json;
+using Dit.HumanBehavior.Contracts;
+using Dit.HumanBehavior.DialogueWording;
+using Dit.HumanBehavior.Neuronetwork.Client;
+using Xunit;
+
+namespace Dit.HumanBehavior.Neuronetwork.Tests;
+
+[Collection("Producer context environment")]
+public sealed class ProducerContextBoundaryTests
+{
+    private const string MatchingText = "fixture response";
+    private const string WrongText = "unrelated prepared wording";
+    private const string LocalText = "fixture local response";
+
+    private sealed class Local : IDialogueWordingProvider
+    {
+        public string ProviderName => "fixture-local";
+        public int Calls;
+        public Task<DialogueWordingResult> GenerateAsync(DialogueWordingRequest request, CancellationToken ct)
+        {
+            Calls++;
+            return Task.FromResult(new DialogueWordingResult(request.RequestId, ProviderName, "fixture", LocalText,
+                DialogueWordingCompletionStatus.Succeeded, TimeSpan.Zero, null, null, false,
+                DialogueProviderFailureClassification.None, request.GenerationPolicyVersion));
+        }
+    }
+
+    private sealed class Hub(string fault, bool groupShadow) : HttpMessageHandler
+    {
+        private int _calls;
+        public int Calls => _calls;
+        protected override async Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken ct)
+        {
+            Interlocked.Increment(ref _calls);
+            using var body = JsonDocument.Parse(await request.Content!.ReadAsStringAsync(ct));
+            var path = request.RequestUri!.AbsolutePath;
+            var applies = fault != "none" && (!groupShadow || path.EndsWith("/group", StringComparison.Ordinal));
+            var text = applies ? WrongText : MatchingText;
+            object response;
+            if (path.EndsWith("/event", StringComparison.Ordinal))
+            {
+                var actor = body.RootElement.GetProperty("bot").GetProperty("actorKey").GetString();
+                response = new { actorKey = applies && fault == "actor" ? "another-fixture" : applies && fault == "actor-case" ? actor!.ToUpperInvariant() : actor, kind = "say", text, note = "fixture" };
+            }
+            else
+            {
+                var actor = body.RootElement.GetProperty("hearers")[0].GetProperty("actorKey").GetString();
+                var lineId = body.RootElement.GetProperty("lineId").GetString();
+                var decision = new
+                {
+                    actorKey = applies && fault == "actor" ? "another-fixture" : applies && fault == "actor-case" ? actor!.ToUpperInvariant() : actor,
+                    displayName = "Fixture", kind = "say", channel = "tell", text,
+                    reason = "fixture", origin = "fixture", model = "fixture", note = "fixture",
+                };
+                response = new
+                {
+                    lineId = applies && fault == "line" ? "another-line" : lineId, mode = "live",
+                    decisions = applies && fault == "duplicate" ? new[] { decision, decision with { text = "conflicting second draft" } } :
+                        applies && fault == "case-first" ? new[] { decision with { actorKey = actor!.ToUpperInvariant() }, decision } :
+                        applies && fault == "case-last" ? new[] { decision, decision with { actorKey = actor!.ToUpperInvariant() } } : new[] { decision },
+                    notes = Array.Empty<string>(),
+                };
+            }
+            return new(HttpStatusCode.OK) { Content = new StringContent(JsonSerializer.Serialize(response), Encoding.UTF8, "application/json") };
+        }
+    }
+
+    private sealed record Forwarded(DialogueWordingResult Result, IReadOnlyList<string> Reports, int LocalCalls, int HubCalls,
+        int HubAnswers, int HubSilences);
+
+    private static async Task<Forwarded> Forward(string game, string route, string fault, bool selected, string mode = "only")
+    {
+        using var temp = new TempDirectory();
+        var groupShadow = route == "group-shadow";
+        var env = new Dictionary<string, string?>
+        {
+            ["DIT_NEURONETWORK_CONSULT_TOKEN_DIRECTORY"] = temp.Path,
+            ["DIT_" + game.ToUpperInvariant() + "_HUB_CONVERSATION"] = mode,
+            ["DIT_" + game.ToUpperInvariant() + "_GROUP"] = groupShadow ? "shadow" : route == "group" ? "live" : "off",
+            ["DIT_" + game.ToUpperInvariant() + "_GROUP_ACTORS"] = "",
+        };
+        var before = env.Keys.ToDictionary(key => key, Environment.GetEnvironmentVariable);
+        try
+        {
+            foreach (var (key, value) in env) Environment.SetEnvironmentVariable(key, value);
+            File.WriteAllText(Path.Combine(temp.Path, game + ".token"), "synthetic-token");
+            var handler = new Hub(fault, groupShadow);
+            using var http = new HttpClient(handler);
+            var hub = new NeuronetConversationClient(game, http, "http://fixture.invalid");
+            var local = new Local();
+            var reports = new List<string>();
+            using var provider = new NeuronetConversationWordingProvider(local, hub, "fixture-instance", reports.Add);
+            provider.ContextEnvironment = _ => selected ? game : null;
+            var now = DateTimeOffset.UtcNow;
+            var current = route == "event" ? null : "Fixture current message";
+            var trigger = current is null ? ValueList<DialogueContextFact>.Empty :
+                ValueList<DialogueContextFact>.From([new("untrusted_player_message", "Legacy current message")]);
+            var request = new DialogueWordingRequest("fixture-intent", new(game, "fixture-instance", GameEnvironment.IsolatedTest),
+                new(ActorIdentityKind.GameNativeActor, "player_bot", "fixture", null, "Fixture"), "social_nearby", "Say something brief",
+                "fixture.turn", trigger, "tell", "single_player", "Friendly", "Brief", null, "stranger", "Synthetic conversation",
+                "unknown", null, 100, 200, "en-US", "fixture-v1", "neuronet_conversation", "...", DialogueFallbackPolicy.Silence,
+                new DialogueOutputConstraints(), now, now.AddSeconds(30), "fixture-line",
+                conversationContext: new(ValueList<string>.From(["Player: earlier line"]), current));
+            var result = await provider.GenerateAsync(request, default);
+            return new(result, reports, local.Calls, handler.Calls, provider.HubAnswers, provider.HubSilences);
+        }
+        finally { foreach (var (key, value) in before) Environment.SetEnvironmentVariable(key, value); }
+    }
+
+    [Theory]
+    [InlineData("ffxi", "reply", "line")] [InlineData("swtor", "reply", "line")]
+    [InlineData("ffxi", "reply", "actor")] [InlineData("swtor", "reply", "actor")]
+    [InlineData("ffxi", "reply", "duplicate")] [InlineData("swtor", "reply", "duplicate")]
+    [InlineData("ffxi", "group", "line")] [InlineData("swtor", "group", "line")]
+    [InlineData("ffxi", "group", "duplicate")] [InlineData("swtor", "group", "duplicate")]
+    [InlineData("ffxi", "event", "actor")] [InlineData("swtor", "event", "actor")]
+    [InlineData("ffxi", "reply", "actor-case")] [InlineData("swtor", "reply", "actor-case")]
+    [InlineData("ffxi", "group", "actor-case")] [InlineData("swtor", "group", "actor-case")]
+    [InlineData("ffxi", "group", "case-first")] [InlineData("swtor", "group", "case-first")]
+    [InlineData("ffxi", "group", "case-last")] [InlineData("swtor", "group", "case-last")]
+    [InlineData("ffxi", "event", "actor-case")] [InlineData("swtor", "event", "actor-case")]
+    public async Task Selected_context_withholds_wrong_or_ambiguous_response_without_changing_legacy(string game, string route, string fault)
+    {
+        var rejected = await Forward(game, route, fault, selected: true);
+        Assert.Null(rejected.Result.CandidateText);
+        Assert.Equal("hub_response_mismatch", rejected.Result.SafeTelemetryMetadata["hub_decision"]);
+        Assert.Equal(0, rejected.HubAnswers);
+        Assert.Equal(1, rejected.HubSilences);
+        Assert.Equal(0, rejected.LocalCalls);
+        Assert.Equal(1, rejected.HubCalls);
+        Assert.Contains(rejected.Reports, report => report.Contains("response scope mismatch", StringComparison.Ordinal));
+        Assert.DoesNotContain(rejected.Reports, report => report.Contains(WrongText, StringComparison.Ordinal));
+
+        var matching = await Forward(game, route, "none", selected: true);
+        Assert.Equal(MatchingText, matching.Result.CandidateText);
+        Assert.Equal(1, matching.HubAnswers);
+        Assert.Equal(0, matching.HubSilences);
+
+        var legacy = await Forward(game, route, fault, selected: false);
+        Assert.Equal(WrongText, legacy.Result.CandidateText);
+        Assert.Equal(1, legacy.HubAnswers);
+        Assert.Equal(0, legacy.HubSilences);
+    }
+
+    [Theory]
+    [InlineData("ffxi")] [InlineData("swtor")]
+    public async Task Selected_live_mismatch_does_not_invoke_local_fallback(string game)
+    {
+        var rejected = await Forward(game, "reply", "actor", selected: true, mode: "live");
+        Assert.Null(rejected.Result.CandidateText);
+        Assert.Equal("hub_response_mismatch", rejected.Result.SafeTelemetryMetadata["hub_decision"]);
+        Assert.Equal(0, rejected.LocalCalls);
+        Assert.Equal(1, rejected.HubCalls);
+    }
+
+    [Theory]
+    [InlineData("ffxi", false)] [InlineData("swtor", false)]
+    [InlineData("ffxi", true)] [InlineData("swtor", true)]
+    public async Task Rejected_shadow_text_is_not_reported_and_does_not_replace_authoritative_wording(string game, bool group)
+    {
+        var result = await Forward(game, group ? "group-shadow" : "reply", "line", selected: true, mode: group ? "only" : "shadow");
+        Assert.Equal(group ? MatchingText : LocalText, result.Result.CandidateText);
+        Assert.Equal(group ? 0 : 1, result.LocalCalls);
+        Assert.Equal(group ? 2 : 1, result.HubCalls);
+        Assert.Contains(result.Reports, report => report.Contains("response scope mismatch", StringComparison.Ordinal));
+        Assert.DoesNotContain(result.Reports, report => report.Contains(WrongText, StringComparison.Ordinal));
+        Assert.DoesNotContain(result.Reports, report => report.Contains("hub unreachable", StringComparison.Ordinal));
+    }
+}
