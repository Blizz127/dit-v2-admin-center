+using Dit.HumanBehavior.DialogueWording;
+using Dit.HumanBehavior.Neuronetwork.Conversation;
+using Dit.HumanBehavior.Neuronetwork.Conversation.Arbitration;
+using Dit.HumanBehavior.Neuronetwork.Conversation.Companionship;
+using Dit.HumanBehavior.Neuronetwork.Games.TabulaRasa;
+using Dit.HumanBehavior.Neuronetwork.Store;
+using Xunit;
+
+namespace Dit.HumanBehavior.Neuronetwork.Tests;
+
+public sealed class CrossGameLeadIsolationTests
+{
+    private const string Draft = "want me to show you?";
+
+    private sealed class Clock : TimeProvider
+    {
+        public override DateTimeOffset GetUtcNow() => new(2030, 1, 1, 0, 0, 0, TimeSpan.Zero);
+    }
+
+    private sealed class Provider : IDialogueWordingProvider
+    {
+        public readonly List<DialogueWordingRequest> Requests = [];
+        public string ProviderName => "synthetic-cross-game-lead";
+        public Task<DialogueWordingResult> GenerateAsync(DialogueWordingRequest request, CancellationToken token)
+        {
+            Requests.Add(request);
+            return Task.FromResult(new DialogueWordingResult(request.RequestId, ProviderName, "fake", Draft,
+                DialogueWordingCompletionStatus.Succeeded, TimeSpan.Zero, null, null, true,
+                DialogueProviderFailureClassification.None, request.GenerationPolicyVersion));
+        }
+    }
+
+    // A preinstalled guide must stay untouched for another game. No native executor is installed.
+    private sealed class RecordingExecutor : ICompanionActionExecutor
+    {
+        public string GameId => TrLeadExecutor.Game;
+        public readonly List<string> Calls = [];
+        public string? ExtraCannotOffer(FollowThrough.Actor bot, FollowThrough.Actor owner)
+        {
+            Calls.Add("eligibility");
+            return null;
+        }
+        public string? ResolveTarget(string text, string place)
+        {
+            Calls.Add("target");
+            return "synthetic-target";
+        }
+        public void Send(FollowThrough.Active order, string name) => Calls.Add("send:" + name);
+    }
+
+    [Theory]
+    [InlineData("ffxi", true)] [InlineData("swtor", true)]
+    [InlineData("ffxi", false)] [InlineData("swtor", false)]
+    public async Task Installed_TR_guide_does_not_handle_another_games_request_or_offer(string game, bool selected)
+    {
+        using var store = new NeuronetworkStore(":memory:");
+        var clock = new Clock();
+        var provider = new Provider();
+        var executor = new RecordingExecutor();
+        var guide = new FollowThrough(executor);
+        var service = new ConversationService(store, provider, clock)
+        {
+            TrGuide = guide,
+            ContextEnvironment = _ => selected ? game : null,
+            StatusEnvironment = _ => null, ChatVoiceEnvironment = _ => null,
+            QuickReplies = false, KnowledgeAnswers = false,
+            CompanionExtractor = null, CompanionExtractorForGame = null,
+        };
+        service.Group.Environment = _ => null;
+        service.Group.SingleModelReplyForGame = _ => true;
+        var line = new GroupLine
+        {
+            GameId = game, ServerInstanceId = "synthetic-instance", LineId = "synthetic-guide-request",
+            Scope = "synthetic-room", Channel = game == "ffxi" ? "linkshell" : "party",
+            Speaker = new GroupSpeaker("PlayerFixture", IsOwner: true),
+            Text = "can you take me to the fixture marker?",
+            History = ["PlayerFixture: a supplied earlier observation"],
+            Hearers = [new GroupHearer { ActorKey = "fixture-bot", DisplayName = "Fixture", Addressed = true, InPartyWithSpeaker = true }],
+            Guarantee = true,
+        };
+        // Exercise request, eligibility, and offer-shaped output in the same ordinary reply.
+        Assert.True(TrLeadExecutor.IsLeadRequest(line.Text));
+        Assert.True(TrLeadExecutor.IsLeadOffer(Draft));
+        Assert.Null(GroundingContract.Unkeepable(game, Draft));
+
+        var decision = Assert.Single((await service.Group.ReplyAsync(line, default)).Decisions);
+
+        Assert.Equal("say", decision.Kind);
+        Assert.Equal(Draft, decision.Text);
+        Assert.Null(decision.Action);
+        Assert.Empty(executor.Calls);
+        Assert.Null(guide.CurrentFor(line.Speaker.Name));
+        Assert.Null(guide.Accepts(line.Speaker.Name, "yes please", [], clock.GetUtcNow()));
+        var request = Assert.Single(provider.Requests);
+        Assert.Equal(game, request.Game.GameId);
+        if (selected) Assert.Equal(line.History, request.ConversationContext!.History);
+        else Assert.Null(request.ConversationContext);
+        // The ordinary route retains its existing selected/legacy memory behavior.
+        Assert.Equal(!selected, service.Pairs.History(game, "Fixture", line.Speaker.Name).Contains("Fixture: " + Draft));
+    }
+}
diff --git a/tests/Dit.HumanBehavior.Neuronetwork.Tests/FfxiConversationStatusSourceTests.cs b/tests/Dit.HumanBehavior.Neuronetwork.Tests/FfxiConversationStatusSourceTests.cs
