+using System.Reflection;
+using System.Text.Json;
+using System.Text.Json.Serialization;
+using Dit.HumanBehavior.Contracts;
+using Dit.HumanBehavior.DialogueWording;
+using Dit.HumanBehavior.DialogueWording.DeepSeek;
+using Dit.HumanBehavior.Neuronetwork.Conversation;
+using Dit.HumanBehavior.Neuronetwork.Knowledge;
+using Dit.HumanBehavior.Neuronetwork.Store;
+using Xunit;
+
+namespace Dit.HumanBehavior.Neuronetwork.Tests;
+
+public sealed class ConversationStatusIntegrationTests
+{
+    private static readonly DateTimeOffset Start = new(2030, 1, 1, 0, 0, 0, TimeSpan.Zero);
+    private static readonly string[] History = Enumerable.Range(0, 12).Select(i => $"Player: synthetic turn {i:D2}").ToArray();
+    private sealed class Clock : TimeProvider { public DateTimeOffset Now = Start; public override DateTimeOffset GetUtcNow() => Now; }
+    private sealed class Source : IConversationStatusSource
+    {
+        public int Calls;
+        public Func<ConversationStatusLookup, ConversationStatusCapture?> Read = Fixture;
+        public ConversationStatusCapture? Capture(ConversationStatusLookup lookup) { Calls++; return Read(lookup); }
+    }
+    private sealed class Provider : IDialogueWordingProvider
+    {
+        public string ProviderName => "offline-integration-fixture";
+        public List<DialogueWordingRequest> Requests = [];
+        public Action? DuringWording;
+        public bool Succeed;
+        public Task<DialogueWordingResult> GenerateAsync(DialogueWordingRequest request, CancellationToken token)
+        {
+            Requests.Add(request);
+            DuringWording?.Invoke();
+            return Task.FromResult(new DialogueWordingResult(request.RequestId, ProviderName, "fixture", Succeed ? "hey there" : null,
+                Succeed ? DialogueWordingCompletionStatus.Succeeded : DialogueWordingCompletionStatus.Unavailable, TimeSpan.Zero, null, null, false,
+                Succeed ? DialogueProviderFailureClassification.None : DialogueProviderFailureClassification.Availability, request.GenerationPolicyVersion));
+        }
+    }
+    private static ConversationStatusCapture Fixture(ConversationStatusLookup lookup)
+    {
+        var body = new StatusBodyIdentity(lookup.Game, "synthetic-realm", lookup.ServerInstance, "native-fixture-id");
+        var expected = new StatusExpectation(body, "synthetic-epoch", 7);
+        var fields = ValueList<StatusFieldObservation>.From([
+            new(StatusField.Presence, "online", Start, Start.AddMinutes(1)),
+            new(StatusField.Location, "Synthetic native west entrance", Start, Start.AddMinutes(1)),
+            new(StatusField.Activity, "resting at the entrance", Start, Start.AddMinutes(1)),
+        ]);
+        var frame = new StatusSnapshot(body, expected.Epoch, expected.Sequence, "fixture-native-adapter", StatusOrigin.NativeAdapter, true, Start, fields);
+        var policy = new ConversationStatusPolicy("fixture-native-adapter", "synthetic-policy-v1",
+            Enum.GetValues<StatusField>().ToDictionary(f => f, f => TimeSpan.FromSeconds(f == StatusField.Presence ? 60 : 10)));
+        return new(lookup, expected, frame, policy);
+    }
+    private static ConversationHearer Bot() => new()
+    {
+        ActorKey = "fixture", DisplayName = "Fixture", Addressed = true, Hero = "LegacyPoisonJob", Level = 99,
+        Situation = "LegacyPoisonActivity", Facts = [new("place", "LegacyPoisonPlace"), new("doing", "LegacyPoisonDoing")]
+    };
+    private static CompanionLine Line(string game) => new()
+    {
+        GameId = game, ServerInstanceId = "synthetic-instance", Persona = "Fixture", Speaker = "Player", SpeakerIsOwner = true,
+        Text = "Fixture, are you around?", Channel = game == "ffxi" ? "linkshell" : "party", Shadow = true, History = History,
+        Bot = Bot(), Facts = [new("live_state", "LegacyPoisonLiveState"), new("knowledge_lookup_ref1", "Synthetic reference, not personal status")]
+    };
+    private static ConversationService Service(NeuronetworkStore store, Provider provider, Clock clock, Source? source,
+        string? context = "ffxi,swtor", string? status = "ffxi,swtor") => new(store, provider, clock)
+    {
+        ContextEnvironment = _ => context, StatusEnvironment = _ => status,
+        RecentContextEnvironment = _ => "1", SharedStatusSource = source, QuickReplies = false, KnowledgeAnswers = false
+    };
+    private static DialogueWordingRequest CompanionRequest(ConversationService service, CompanionLine line, bool rewrite = false) =>
+        (DialogueWordingRequest)typeof(ConversationService).GetMethod("CompanionRequest", BindingFlags.NonPublic | BindingFlags.Instance)!
+            .Invoke(service, [line, new ConversationContext.Actor("fixture", "Fixture", "casual", "brief", line.GameId),
+                Array.Empty<string>(), Start, rewrite ? "synthetic rewrite reason" : null])!;
+    private static DialogueWordingPromptTextContent Wire(DialogueWordingRequest request)
+    {
+        var type = typeof(DeepSeekDialogueWordingProvider).Assembly.GetType("Dit.HumanBehavior.DialogueWording.DeepSeek.DeepSeekPromptSerializer")!;
+        var wire = type.GetMethod("Serialize", BindingFlags.Static | BindingFlags.NonPublic)!.Invoke(null, [request, new DeepSeekDialogueWordingOptions()])!;
+        using var json = JsonDocument.Parse((byte[])wire.GetType().GetProperty("Utf8Json")!.GetValue(wire)!);
+        var messages = json.RootElement.GetProperty("messages");
+        var prompt = DialogueWordingPromptText.Build(request);
+        Assert.Equal(prompt.SystemMessage, messages[0].GetProperty("content").GetString());
+        Assert.Equal(prompt.UserMessage, messages[1].GetProperty("content").GetString());
+        return prompt;
+    }
+    private static void AssertBound(ConversationService service, DialogueWordingRequest request, bool known)
+    {
+        var prompt = Wire(request);
+        Assert.DoesNotContain("LegacyPoison", prompt.UserMessage);
+        Assert.Equal(12, prompt.ContextReceipt!.IncludedHistoryTurns);
+        Assert.Equal(History, request.ConversationContext!.History);
+        var binding = Assert.IsType<ConversationStatusBinding>(service.StatusBindingFor(request));
+        Assert.Equal(request.RequestId, binding.RequestId);
+        Assert.Equal(request.RequestId, prompt.ContextReceipt.RequestId);
+        Assert.Equal(known, request.ApprovedGameWorldFacts.Any(f => f.Key == "native_status_location"));
+        Assert.Equal(known ? "native_observed" : "unknown", request.CurrentHighLevelActivity);
+        if (known)
+        {
+            Assert.Contains("Synthetic native west entrance", prompt.UserMessage);
+            Assert.Equal(binding.View!.RevisionSha256, request.ApprovedGameWorldFacts.Single(f => f.Key == "native_status_revision").Value);
+        }
+    }
+
+    [Theory]
+    [InlineData("ffxi", "linkshell", false, true, "linkshell", false)]
+    [InlineData("ffxi", "say", false, true, "say", false)]
+    [InlineData("ffxi", "shout", false, true, "party", true)]
+    [InlineData("ffxi_forever", "shout", false, true, "party", true)]
+    [InlineData("ffxi", "tell", true, true, "tell", false)]
+    [InlineData("swtor", "party", false, true, "party", false)]
+    [InlineData("ffxi", "shout", false, false, "party", true)]
+    public void Status_binding_and_rewrite_preserve_channel_voice_and_complete_context(
+        string game, string channel, bool isPrivate, bool statusEnabled, string expectedChannel, bool suppressVoice)
+    {
+        using var store = new NeuronetworkStore(":memory:");
+        var source = new Source();
+        var service = Service(store, new Provider(), new Clock(), source,
+            context: game, status: statusEnabled ? game : null);
+        service.ChatVoiceEnvironment = _ => game;
+        var line = Line(game) with { Channel = channel, Private = isPrivate };
+        foreach (var rewrite in new[] { false, true })
+        {
+            var request = CompanionRequest(service, line, rewrite);
+            Assert.Equal(expectedChannel, request.Channel);
+            Assert.Equal(suppressVoice, request.SuppressSharedVoiceGuidance);
+            Assert.Equal(History, request.ConversationContext!.History);
+            Assert.Equal(line.Text, request.ConversationContext.CurrentMessage);
+            var prompt = DialogueWordingPromptText.Build(request, game);
+            Assert.Equal(12, prompt.ContextReceipt!.IncludedHistoryTurns);
+            Assert.Equal(!suppressVoice, prompt.SystemMessage.Contains("varied, characterful banter", StringComparison.Ordinal));
+            var withoutVoice = DialogueWordingPromptText.Build(request, null);
+            Assert.Equal(suppressVoice, prompt.ContextReceipt.PromptSha256 == withoutVoice.ContextReceipt!.PromptSha256);
+            Assert.Equal(prompt.SystemMessage.Length + prompt.UserMessage.Length, prompt.ContextReceipt.SerializedCharacters);
+            Assert.Equal(statusEnabled, service.StatusBindingFor(request) is not null);
+            Assert.Equal(rewrite, request.TriggerFacts.Any(fact => fact.Key == "rewrite"));
+
+            // Status binding rebuilds the request. Its wording/context must also
+            // survive the actual JSON serializer used at the wording boundary.
+            var encoded = NeuronetworkJson.Serialize(request);
+            using var document = JsonDocument.Parse(encoded);
+            Assert.Equal(suppressVoice, document.RootElement.TryGetProperty("suppressSharedVoiceGuidance", out var suppression));
+            if (suppressVoice) Assert.True(suppression.GetBoolean());
+            var restored = NeuronetworkJson.Deserialize<DialogueWordingRequest>(encoded);
+            Assert.Equal(suppressVoice, restored.SuppressSharedVoiceGuidance);
+            Assert.Equal(request.RequestId, restored.RequestId);
+            Assert.Equal(History, restored.ConversationContext!.History);
+            Assert.Equal(line.Text, restored.ConversationContext.CurrentMessage);
+            Assert.Equal(prompt, DialogueWordingPromptText.Build(restored, game));
+            Assert.Equal(rewrite, restored.TriggerFacts.Any(fact => fact.Key == "rewrite"));
+        }
+        Assert.Equal(statusEnabled ? 2 : 0, source.Calls);
+    }
+
+    [Theory]
+    [InlineData("ffxi", "companion")] [InlineData("swtor", "companion")]
+    [InlineData("ffxi", "heard")] [InlineData("swtor", "heard")]
+    [InlineData("ffxi", "intent")] [InlineData("swtor", "intent")]
+    public async Task Actual_reply_paths_bind_projected_status_and_complete_history_to_wire(string game, string path)
+    {
+        using var store = new NeuronetworkStore(":memory:");
+        var provider = new Provider(); var clock = new Clock(); var source = new Source();
+        var service = Service(store, provider, clock, source);
+        if (path == "companion") await service.CompanionReplyAsync(Line(game), default);
+        if (path == "heard") await service.ReplyAsync(new ConversationHeard
+        {
+            GameId = game, ServerInstanceId = "synthetic-instance", LineId = "synthetic-turn", Channel = "tell",
+            Speaker = new("Player", true), Text = "Fixture, are you around?", Hearers = [Bot()], History = History, Mode = "shadow"
+        }, default);
+        if (path == "intent") await service.WordIntentAsync(game, "synthetic-instance", Bot(), "Say something brief", "party", History, "LegacyPoisonPlace", 120, default);
+        var request = Assert.Single(provider.Requests);
+        AssertBound(service, request, true); Assert.Equal(1, source.Calls);
+        if (Environment.GetEnvironmentVariable("DIT_INTEGRATION_FIXTURE_OUTPUT") is { Length: > 0 } output)
+        {
+            Directory.CreateDirectory(output);
+            var prompt = Wire(request);
+            File.WriteAllText(Path.Combine(output, game + "-" + path + ".json"), JsonSerializer.Serialize(new
+            {
+                schema = "dit.context-status-integration.v1", synthetic = true, game, path,
+                suppliedHistory = History, systemMessage = prompt.SystemMessage, userMessage = prompt.UserMessage,
+                contextReceipt = prompt.ContextReceipt, statusBinding = service.StatusBindingFor(request),
+                delivery = "not attempted", modelCall = "not attempted"
+            }, new JsonSerializerOptions { WriteIndented = true, Converters = { new JsonStringEnumConverter() } }));
+        }
+    }
+
+    [Theory]
+    [InlineData(null, null)] [InlineData("ffxi", null)] [InlineData(null, "ffxi")]
+    [InlineData("ffxi", "ffxi")] [InlineData("ffxi", "swtor")] [InlineData("ffxi", "ffxi-extra")]
+    public void Flags_are_independent_exact_scoped_and_default_off(string? context, string? status)
+    {
+        using var store = new NeuronetworkStore(":memory:");
+        var source = new Source(); var service = Service(store, new Provider(), new Clock(), source, context, status);
+        var request = CompanionRequest(service, Line("ffxi"));
+        Assert.Equal(context == "ffxi", request.ConversationContext is not null);
+        Assert.Equal(status == "ffxi" ? 1 : 0, source.Calls);
+        Assert.Equal(status == "ffxi", service.StatusBindingFor(request) is not null);
+        Assert.Equal(status != "ffxi", DialogueWordingPromptText.Build(request).UserMessage.Contains("LegacyPoison", StringComparison.Ordinal));
+    }
+
+    [Theory]
+    [InlineData("ffxi")] [InlineData("swtor")]
+    public async Task Empty_intent_context_is_a_valid_packet_without_a_recent_conversation_section(string game)
+    {
+        using var store = new NeuronetworkStore(":memory:");
+        var provider = new Provider(); var service = Service(store, provider, new Clock(), null);
+        await service.WordIntentAsync(game, "synthetic-instance", Bot(), "Say something brief", "party", [], "", 120, default);
+        var request = Assert.Single(provider.Requests); var prompt = Wire(request);
+        Assert.Empty(request.ConversationContext!.History); Assert.Null(request.ConversationContext.CurrentMessage);
+        Assert.Equal(0, prompt.ContextReceipt!.SuppliedHistoryTurns);
+        Assert.Equal(0, prompt.ContextReceipt.IncludedHistoryTurns); Assert.Equal(0, prompt.ContextReceipt.OmittedHistoryTurns);
+        Assert.DoesNotContain("UNTRUSTED RECENT CONVERSATION\n", prompt.UserMessage);
+        Assert.Null(service.StatusBindingFor(request)!.View);
+        if (Environment.GetEnvironmentVariable("DIT_EMPTY_CONTEXT_FIXTURE_OUTPUT") is { Length: > 0 } output)
+        {
+            Directory.CreateDirectory(output);
+            File.WriteAllText(Path.Combine(output, game + "-empty-intent.json"), JsonSerializer.Serialize(new
+            {
+                schema = "dit.context-status-integration.v1", synthetic = true, game, path = "intent",
+                suppliedHistory = Array.Empty<string>(), systemMessage = prompt.SystemMessage, userMessage = prompt.UserMessage,
+                contextReceipt = prompt.ContextReceipt, statusBinding = service.StatusBindingFor(request),
+                delivery = "not attempted", modelCall = "not attempted"
+            }, new JsonSerializerOptions { WriteIndented = true, Converters = { new JsonStringEnumConverter() } }));
+        }
+    }
+
+    [Theory]
+    [InlineData("ffxi")] [InlineData("swtor")]
+    public void Rewrite_recaptures_freshness_without_losing_history_or_correction(string game)
+    {
+        using var store = new NeuronetworkStore(":memory:");
+        var clock = new Clock(); var source = new Source(); var service = Service(store, new Provider(), clock, source);
+        var original = CompanionRequest(service, Line(game)); AssertBound(service, original, true);
+        clock.Now = Start.AddSeconds(10);
+        var rewrite = CompanionRequest(service, Line(game), true); AssertBound(service, rewrite, false);
+        Assert.Contains(rewrite.TriggerFacts, f => f.Key == "rewrite");
+        Assert.Contains(rewrite.ApprovedGameWorldFacts, f => f.Key == "native_status_location_state" && f.Value.StartsWith("stale:"));
+        Assert.NotEqual(original.RequestId, rewrite.RequestId); Assert.Equal(2, source.Calls);
+    }
+
+    [Theory]
+    [InlineData("missing")] [InlineData("error")] [InlineData("binding")] [InlineData("epoch")]
+    [InlineData("actor")] [InlineData("game")] [InlineData("instance")] [InlineData("gap")]
+    [InlineData("offline")]
+    [InlineData("denied")]
+    public void Status_failure_or_disconnect_never_falls_back_to_legacy_body_facts(string failure)
+    {
+        using var store = new NeuronetworkStore(":memory:");
+        var source = new Source { Read = lookup =>
+        {
+            var read = Fixture(lookup);
+            return failure switch
+            {
+                "missing" => null,
+                "error" => throw new IOException("secret path must never enter prompt"),
+                "denied" => throw new UnauthorizedAccessException("secret path must never enter prompt"),
+                "binding" => read with { Lookup = lookup with { ActorKey = "other" } },
+                "epoch" => read with { Snapshot = read.Snapshot! with { Epoch = "retired-epoch" } },
+                "actor" => read with { Snapshot = read.Snapshot! with { Body = read.Snapshot.Body with { NativeActorId = "other" } } },
+                "game" => read with { Expectation = read.Expectation with { Body = read.Expectation.Body with { Game = "swtor" } } },
+                "instance" => read with { Expectation = read.Expectation with { Body = read.Expectation.Body with { Instance = "other" } } },
+                "gap" => read with { Expectation = read.Expectation with { NeedsSnapshot = true } },
+                "offline" => read with { Snapshot = read.Snapshot! with { Fields = ValueList<StatusFieldObservation>.From(read.Snapshot.Fields.Select(f => f.Field == StatusField.Presence ? f with { Value = "offline" } : f)) } },
+                _ => read
+            };
+        }};
+        var service = Service(store, new Provider(), new Clock(), source);
+        var request = CompanionRequest(service, Line("ffxi")); AssertBound(service, request, false);
+        Assert.DoesNotContain("secret path", Wire(request).UserMessage);
+        if (failure is "missing" or "error" or "binding" or "gap" &&
+            Environment.GetEnvironmentVariable("DIT_STATUS_FAILURE_FIXTURE_OUTPUT") is { Length: > 0 } output)
+        {
+            Directory.CreateDirectory(output);
+            var prompt = Wire(request);
+            File.WriteAllText(Path.Combine(output, "ffxi-" + failure + ".json"), JsonSerializer.Serialize(new
+            {
+                schema = "dit.context-status-integration.v1", synthetic = true, game = "ffxi", path = "companion",
+                suppliedHistory = History, systemMessage = prompt.SystemMessage, userMessage = prompt.UserMessage,
+                contextReceipt = prompt.ContextReceipt, statusBinding = service.StatusBindingFor(request),
+                delivery = "not attempted", modelCall = "not attempted"
+            }, new JsonSerializerOptions { WriteIndented = true, Converters = { new JsonStringEnumConverter() } }));
+        }
+    }
+
+    [Fact]
+    public async Task Native_action_outcome_keeps_the_existing_no_extra_consultation_route()
+    {
+        using var store = new NeuronetworkStore(":memory:");
+        var inner = new Provider(); var service = Service(store, inner, new Clock(), new Source());
+        var line = Line("ffxi") with { Facts = [new("native_guide_action_result", "Synthetic native refusal, no action performed")] };
+        var request = CompanionRequest(service, line);
+        Assert.Contains(request.ApprovedGameWorldFacts, f => f.Key == "native_guide_action_result");
+        using var wrapper = new ConsultingDialogueWordingProvider(inner, (_, _) => throw new InvalidOperationException("Unexpected consultation"));
+        await wrapper.GenerateAsync(request, default);
+        Assert.Same(request, Assert.Single(inner.Requests));
+    }
+
+    [Fact]
+    public async Task Saturated_references_cannot_displace_a_native_action_outcome()
+    {
+        using var store = new NeuronetworkStore(":memory:");
+        var inner = new Provider(); var service = Service(store, inner, new Clock(), new Source());
+        var r = CompanionRequest(service, Line("ffxi"));
+        var facts = Enumerable.Range(0, 31).Select(i => new DialogueContextFact("reference_" + i, "Synthetic reference"))
+            .Append(new DialogueContextFact("native_guide_action_result", "Synthetic native refusal, no action performed"));
+        var saturated = new DialogueWordingRequest(r.IntentionId, r.Game, r.Actor, r.SemanticTopic, r.SemanticIntent, r.TriggerType,
+            r.TriggerFacts, r.Channel, r.AudienceType, r.PersonalitySummary, r.CommunicationStyle, r.RelevantMemories,
+            r.RelationshipRole, r.RelationshipSummary, r.CurrentHighLevelActivity, ValueList<DialogueContextFact>.From(facts),
+            r.MaximumOutputCharacters, r.MaximumOutputUtf8Bytes, r.Locale, r.GenerationPolicyVersion, r.TemplateFamily,
+            r.DeterministicFallbackText, r.FallbackPolicy, r.OutputConstraints, r.RequestedAtUtc, r.ExpiresAtUtc,
+            r.CorrelationId, r.CausationId, r.SharedEventMemorySummary, r.ConversationContext);
+        var request = (DialogueWordingRequest)typeof(ConversationService).GetMethod("WithSharedStatus", BindingFlags.Instance | BindingFlags.NonPublic)!
+            .Invoke(service, [saturated, "ffxi", "synthetic-instance", "fixture", null])!;
+        Assert.Equal(32, request.ApprovedGameWorldFacts.Count);
+        Assert.Contains(request.ApprovedGameWorldFacts, f => f.Key == "native_guide_action_result");
+        using var wrapper = new ConsultingDialogueWordingProvider(inner, (_, _) => throw new InvalidOperationException("Unexpected consultation"));
+        await wrapper.GenerateAsync(request, default);
+        Assert.Same(request, Assert.Single(inner.Requests));
+    }
+
+    [Theory]
+    [InlineData("ffxi", "companion")] [InlineData("swtor", "companion")]
+    [InlineData("ffxi", "heard")] [InlineData("swtor", "heard")]
+    [InlineData("ffxi", "intent")] [InlineData("swtor", "intent")]
+    public async Task Status_expiring_during_wording_withholds_the_result_without_another_model_call(string game, string path)
+    {
+        using var store = new NeuronetworkStore(":memory:");
+        var clock = new Clock(); var source = new Source();
+        var provider = new Provider { Succeed = true, DuringWording = () => clock.Now = Start.AddSeconds(10) };
+        var service = Service(store, provider, clock, source);
+        if (path == "companion")
+        {
+            var result = await service.CompanionReplyAsync(Line(game), default);
+            Assert.Null(result.Text); Assert.Contains("shared status changed", result.Note);
+        }
+        if (path == "heard")
+        {
+            var result = await service.ReplyAsync(new ConversationHeard
+            {
+                GameId = game, ServerInstanceId = "synthetic-instance", LineId = "synthetic-expiry", Channel = "tell",
+                Speaker = new("Player", true), Text = "Fixture, are you around?", Hearers = [Bot()], History = History, Mode = "shadow"
+            }, default);
+            Assert.Null(result.Spoken);
+        }
+        if (path == "intent")
+        {
+            var result = await service.WordIntentAsync(game, "synthetic-instance", Bot(), "Say something brief", "party", History, "LegacyPoisonPlace", 120, default);
+            Assert.Null(result.Text); Assert.Contains("shared status changed", result.Note);
+        }
+        Assert.Single(provider.Requests); Assert.Equal(2, source.Calls);
+    }
+
+    [Theory]
+    [InlineData("unchanged", true)] [InlineData("heartbeat", true)] [InlineData("location", false)]
+    [InlineData("epoch", false)] [InlineData("source-error", false)] [InlineData("flag-disabled", false)]
+    public async Task Revalidation_allows_unchanged_facts_but_refuses_changed_binding(string change, bool accepted)
+    {
+        using var store = new NeuronetworkStore(":memory:");
+        var clock = new Clock(); var source = new Source(); var provider = new Provider { Succeed = true };
+        var service = Service(store, provider, clock, source);
+        provider.DuringWording = () =>
+        {
+            clock.Now = Start.AddSeconds(1);
+            if (change == "flag-disabled") service.StatusEnvironment = _ => null;
+            source.Read = lookup =>
+            {
+                var capture = Fixture(lookup); var frame = capture.Snapshot!;
+                return change switch
+                {
+                    "heartbeat" => capture with { Expectation = capture.Expectation with { Sequence = 8 }, Snapshot = frame with { Sequence = 8, ReceivedAtUtc = clock.Now } },
+                    "epoch" => capture with { Expectation = capture.Expectation with { Epoch = "new-epoch" }, Snapshot = frame with { Epoch = "new-epoch" } },
+                    "location" => capture with { Snapshot = frame with { Fields = ValueList<StatusFieldObservation>.From(frame.Fields.Select(f => f.Field == StatusField.Location ? f with { Value = "Synthetic east entrance" } : f)) } },
+                    "source-error" => throw new IOException("source unavailable"),
+                    _ => capture
+                };
+            };
+        };
+        var result = await service.WordIntentAsync("swtor", "synthetic-instance", Bot(), "Say something brief", "party", History, "LegacyPoisonPlace", 120, default);
+        Assert.Equal(accepted, result.Text is not null);
+        Assert.Single(provider.Requests);
+    }
+}
diff --git a/tests/Dit.HumanBehavior.Neuronetwork.Tests/ConversationStatusProjectionTests.cs b/tests/Dit.HumanBehavior.Neuronetwork.Tests/ConversationStatusProjectionTests.cs
new file mode 100644
index 0000000000000000000000000000000000000000..ca31632bda3b49d59ece6e3e0219bbba1ef9c94d
--- /dev/null
+++ b/tests/Dit.HumanBehavior.Neuronetwork.Tests/ConversationStatusProjectionTests.cs
@@ -0,0 +1,177 @@
+using System.Text.Json;
+using System.Text.Json.Serialization;
+using Dit.HumanBehavior.Contracts;
+using Dit.HumanBehavior.Neuronetwork.Conversation;
+using Xunit;
+
+namespace Dit.HumanBehavior.Neuronetwork.Tests;
+
+public sealed class ConversationStatusProjectionTests
+{
+    private static readonly DateTimeOffset Now = new(2030, 1, 1, 0, 0, 0, TimeSpan.Zero);
+    private static StatusBodyIdentity Body(string game = "ffxi") => new(game, "synthetic-realm", "synthetic-instance", "native-fixture-1");
+    private static StatusExpectation Expected(string game = "ffxi") => new(Body(game), "epoch-2", 7);
+    private static ConversationStatusPolicy Policy() => new("fixture-native-adapter", "synthetic-expiry-v1", Ages());
+    private static Dictionary<StatusField, TimeSpan> Ages() => Enum.GetValues<StatusField>()
+        .ToDictionary(f => f, f => TimeSpan.FromSeconds(f == StatusField.Presence ? 60 : 20));
+    private static StatusSnapshot Frame(string game = "ffxi") => new(Body(game), "epoch-2", 7, "fixture-native-adapter",
+        StatusOrigin.NativeAdapter, true, Now, ValueList<StatusFieldObservation>.From([
+            new(StatusField.Presence, "online", Now, Now.AddSeconds(60)),
+            new(StatusField.Location, "Synthetic western entrance", Now, Now.AddSeconds(60)),
+            new(StatusField.Activity, "resting", Now, Now.AddSeconds(60))
+        ]));
+    private static StatusSnapshot Fields(StatusSnapshot frame, params StatusFieldObservation[] values) =>
+        frame with { Fields = ValueList<StatusFieldObservation>.From(values) };
+    private static StatusFieldView Field(ConversationStatusView view, StatusField field) => view.Fields.Single(f => f.Field == field);
+    private static void AssertUnavailable(ConversationStatusView view, string reason)
+    {
+        Assert.Empty(view.ApprovedFacts); Assert.Null(view.RevisionSha256); Assert.Null(view.Source);
+        Assert.All(view.Fields, f => { Assert.Equal(StatusKnowledge.Unknown, f.State); Assert.Null(f.Value); Assert.Equal(reason, f.Reason); });
+    }
+
+    [Theory]
+    [InlineData("ffxi")] [InlineData("swtor")]
+    public void Shared_readers_get_same_revision_and_only_their_scoped_native_facts(string game)
+    {
+        var snapshot = Frame(game);
+        var bot = ConversationStatusProjection.Build(Expected(game), snapshot, Policy(), Now);
+        var inspector = ConversationStatusProjection.Build(Expected(game), snapshot, Policy(), Now);
+        Assert.Equal(bot.RevisionSha256, inspector.RevisionSha256);
+        Assert.Equal(bot.Fields, inspector.Fields);
+        Assert.Equal("Synthetic western entrance", Field(bot, StatusField.Location).Value);
+        Assert.Equal(Now.AddSeconds(20), Field(bot, StatusField.Location).ValidUntilUtc);
+        Assert.Equal(StatusKnowledge.Unknown, Field(bot, StatusField.Level).State);
+        Assert.DoesNotContain(bot.ApprovedFacts, f => f.Key.EndsWith("level"));
+        Assert.Equal(3, bot.ApprovedFacts.Count);
+        if (Environment.GetEnvironmentVariable("DIT_STATUS_FIXTURE_OUTPUT") is { Length: > 0 } output)
+        {
+            Directory.CreateDirectory(output);
+            var options = new JsonSerializerOptions { WriteIndented = true, Converters = { new JsonStringEnumConverter() } };
+            File.WriteAllText(Path.Combine(output, game + "-status.json"), JsonSerializer.Serialize(new
+            {
+                schema = "dit.status-preview.v1", synthetic = true,
+                source = "Offline shared status projection, no producer integration or game access",
+                known = bot,
+                aged = ConversationStatusProjection.Build(Expected(game), snapshot, Policy(), Now.AddSeconds(20)),
+                disconnected = ConversationStatusProjection.Build(Expected(game), Fields(snapshot,
+                    new(StatusField.Presence, "offline", Now, Now.AddSeconds(60)), snapshot.Fields[1]), Policy(), Now)
+            }, options));
+        }
+    }
+
+    [Theory]
+    [InlineData("game")] [InlineData("realm")] [InlineData("instance")] [InlineData("actor")]
+    public void Same_display_name_cannot_cross_body_boundaries(string changed)
+    {
+        var original = Frame();
+        var wrong = original.Body with
+        {
+            Game = changed == "game" ? "swtor" : original.Body.Game,
+            Realm = changed == "realm" ? "another-realm" : original.Body.Realm,
+            Instance = changed == "instance" ? "another-instance" : original.Body.Instance,
+            NativeActorId = changed == "actor" ? "another-actor" : original.Body.NativeActorId
+        };
+        AssertUnavailable(ConversationStatusProjection.Build(Expected(), original with { Body = wrong }, Policy(), Now), "body scope mismatch");
+    }
+
+    [Fact]
+    public void Old_epoch_old_or_ahead_revision_and_sequence_gap_are_unknown()
+    {
+        AssertUnavailable(ConversationStatusProjection.Build(Expected(), Frame() with { Epoch = "epoch-1" }, Policy(), Now), "session epoch mismatch");
+        foreach (var sequence in new[] { 6L, 8L })
+            AssertUnavailable(ConversationStatusProjection.Build(Expected(), Frame() with { Sequence = sequence }, Policy(), Now), "snapshot revision mismatch");
+        AssertUnavailable(ConversationStatusProjection.Build(Expected() with { NeedsSnapshot = true }, Frame(), Policy(), Now), "sequence gap: snapshot required");
+        AssertUnavailable(ConversationStatusProjection.Build(Expected(), Frame() with { Complete = false }, Policy(), Now), "incomplete snapshot");
+    }
+
+    [Theory]
+    [InlineData(StatusOrigin.Conversation)] [InlineData(StatusOrigin.Plan)]
+    public void Chat_and_plans_never_become_native_activity(StatusOrigin origin)
+    {
+        AssertUnavailable(ConversationStatusProjection.Build(Expected(), Frame() with { Origin = origin }, Policy(), Now), "untrusted status source");
+    }
+
+    [Fact]
+    public void Unknown_producer_is_not_promoted_by_claiming_native_origin()
+    {
+        AssertUnavailable(ConversationStatusProjection.Build(Expected(), Frame() with { Source = "other-producer" }, Policy(), Now), "untrusted status source");
+    }
+
+    [Fact]
+    public void Heartbeat_and_duplicate_receipt_do_not_refresh_activity()
+    {
+        var first = ConversationStatusProjection.Build(Expected(), Frame(), Policy(), Now);
+        var later = Now.AddSeconds(20);
+        var replay = Frame() with { ReceivedAtUtc = later };
+        var result = ConversationStatusProjection.Build(Expected(), replay, Policy(), later);
+        Assert.Equal(first.RevisionSha256, result.RevisionSha256);
+        Assert.Equal(StatusKnowledge.Known, Field(result, StatusField.Presence).State);
+        Assert.Equal(StatusKnowledge.Stale, Field(result, StatusField.Activity).State);
+        Assert.Null(Field(result, StatusField.Activity).Value);
+        Assert.Single(result.ApprovedFacts);
+    }
+
+    [Fact]
+    public void Native_validity_can_be_shorter_than_operator_max_age()
+    {
+        var frame = Frame();
+        frame = Fields(frame, frame.Fields[0], frame.Fields[1] with { ValidUntilUtc = Now.AddSeconds(3) });
+        var before = ConversationStatusProjection.Build(Expected(), frame, Policy(), Now.AddSeconds(2));
+        var atExpiry = ConversationStatusProjection.Build(Expected(), frame, Policy(), Now.AddSeconds(3));
+        Assert.Equal(StatusKnowledge.Known, Field(before, StatusField.Location).State);
+        Assert.Equal(StatusKnowledge.Stale, Field(atExpiry, StatusField.Location).State);
+    }
+
+    [Fact]
+    public void Disconnect_or_unconfirmed_presence_withholds_current_body_facts()
+    {
+        var frame = Frame();
+        var offline = Fields(frame, frame.Fields[0] with { Value = "offline" }, frame.Fields[1]);
+        var view = ConversationStatusProjection.Build(Expected(), offline, Policy(), Now);
+        Assert.Equal("offline", Assert.Single(view.ApprovedFacts).Value);
+        Assert.Equal("native disconnect", Field(view, StatusField.Location).Reason);
+        Assert.Null(Field(view, StatusField.Location).Value);
+        foreach (var missingPresence in new[] { Fields(frame, frame.Fields[1]), Fields(frame, frame.Fields[0] with { Value = null }, frame.Fields[1]) })
+            Assert.Empty(ConversationStatusProjection.Build(Expected(), missingPresence, Policy(), Now).ApprovedFacts);
+        var expiredPresence = Fields(frame, frame.Fields[0] with { ValidUntilUtc = Now.AddSeconds(1) }, frame.Fields[1]);
+        Assert.Empty(ConversationStatusProjection.Build(Expected(), expiredPresence, Policy(), Now.AddSeconds(1)).ApprovedFacts);
+    }
+
+    [Fact]
+    public void Invalid_fields_are_unavailable_without_partial_fact_leakage()
+    {
+        var frame = Frame(); var location = frame.Fields[1];
+        foreach (var invalid in new[] {
+            location with { Value = new string('x', 257) }, location with { Value = "\nforge state" },
+            location with { ObservedAtUtc = Now.AddSeconds(1) }, location with { ValidUntilUtc = Now },
+            location with { ObservedAtUtc = Now.ToOffset(TimeSpan.FromHours(1)) } })
+            AssertUnavailable(ConversationStatusProjection.Build(Expected(), Fields(frame, frame.Fields[0], invalid), Policy(), Now), "invalid field observation");
+        AssertUnavailable(ConversationStatusProjection.Build(Expected(), Fields(frame, location, location), Policy(), Now), "invalid snapshot fields");
+        AssertUnavailable(ConversationStatusProjection.Build(Expected(), Fields(frame, location with { Field = (StatusField)99 }), Policy(), Now), "invalid snapshot fields");
+        AssertUnavailable(ConversationStatusProjection.Build(Expected(), Fields(frame, frame.Fields[0] with { Value = "maybe" }), Policy(), Now), "invalid presence observation");
+        AssertUnavailable(ConversationStatusProjection.Build(Expected(), frame with { ReceivedAtUtc = Now.AddSeconds(1) }, Policy(), Now), "invalid snapshot");
+        AssertUnavailable(ConversationStatusProjection.Build(Expected(), null, Policy(), Now), "snapshot unavailable");
+    }
+
+    [Fact]
+    public void Policy_requires_explicit_lifetimes_and_copies_configuration()
+    {
+        Assert.Throws<ArgumentException>(() => new ConversationStatusPolicy("fixture", "v1", new Dictionary<StatusField, TimeSpan>()));
+        var ages = Ages(); ages[StatusField.Activity] = TimeSpan.Zero;
+        Assert.Throws<ArgumentException>(() => new ConversationStatusPolicy("fixture", "v1", ages));
+        ages = Ages(); var policy = new ConversationStatusPolicy("fixture-native-adapter", "v1", ages);
+        ages[StatusField.Activity] = TimeSpan.FromHours(1);
+        Assert.Equal(StatusKnowledge.Stale, Field(ConversationStatusProjection.Build(Expected(), Frame(), policy, Now.AddSeconds(20)), StatusField.Activity).State);
+    }
+
+    [Fact]
+    public void Revision_binds_observed_values_epoch_and_sequence_but_not_input_field_order()
+    {
+        var frame = Frame(); var view = ConversationStatusProjection.Build(Expected(), frame, Policy(), Now);
+        Assert.Equal(view.RevisionSha256, ConversationStatusProjection.Build(Expected(), Fields(frame, frame.Fields.Reverse().ToArray()), Policy(), Now).RevisionSha256);
+        var changed = Fields(frame, frame.Fields[0], frame.Fields[1] with { Value = "Synthetic eastern entrance" });
+        Assert.NotEqual(view.RevisionSha256, ConversationStatusProjection.Build(Expected(), changed, Policy(), Now).RevisionSha256);
+        var next = frame with { Epoch = "epoch-3", Sequence = 0 };
+        Assert.NotEqual(view.RevisionSha256, ConversationStatusProjection.Build(Expected() with { Epoch = next.Epoch, Sequence = 0 }, next, Policy(), Now).RevisionSha256);
+    }
+}
diff --git a/tests/Dit.HumanBehavior.Neuronetwork.Tests/CrossGameLeadIsolationTests.cs b/tests/Dit.HumanBehavior.Neuronetwork.Tests/CrossGameLeadIsolationTests.cs
