diff --git a/tests/Dit.HumanBehavior.Neuronetwork.Tests/PreparedEventMemoryTests.cs b/tests/Dit.HumanBehavior.Neuronetwork.Tests/PreparedEventMemoryTests.cs
new file mode 100644
index 00000000..c88213b5
--- /dev/null
+++ b/tests/Dit.HumanBehavior.Neuronetwork.Tests/PreparedEventMemoryTests.cs
@@ -0,0 +1,100 @@
+using Dit.HumanBehavior.DialogueWording;
+using Dit.HumanBehavior.Neuronetwork.Conversation;
+using Dit.HumanBehavior.Neuronetwork.Store;
+using Xunit;
+
+namespace Dit.HumanBehavior.Neuronetwork.Tests;
+
+public sealed class PreparedEventMemoryTests
+{
+    private static readonly DateTimeOffset Start = new(2030, 1, 1, 0, 0, 0, TimeSpan.Zero);
+
+    private sealed class Clock : TimeProvider
+    {
+        public DateTimeOffset Now = Start;
+        public override DateTimeOffset GetUtcNow() => Now;
+    }
+
+    private sealed class Provider : IDialogueWordingProvider
+    {
+        public readonly List<DialogueWordingRequest> Requests = [];
+        public string ProviderName => "synthetic-prepared-event-memory";
+        public Task<DialogueWordingResult> GenerateAsync(DialogueWordingRequest request, CancellationToken token)
+        {
+            Requests.Add(request);
+            return Task.FromResult(new DialogueWordingResult(request.RequestId, ProviderName, "fake",
+                Requests.Count == 1 ? "nice find" : "anyone exploring?",
+                DialogueWordingCompletionStatus.Succeeded, TimeSpan.Zero, null, null, true,
+                DialogueProviderFailureClassification.None, request.GenerationPolicyVersion));
+        }
+    }
+
+    [Theory]
+    [InlineData("ffxi", true)] [InlineData("swtor", true)]
+    [InlineData("ffxi", false)] [InlineData("swtor", false)]
+    public async Task Prepared_event_wording_is_not_spoken_memory_in_structured_context(string game, bool selected)
+    {
+        using var store = new NeuronetworkStore(":memory:");
+        var clock = new Clock();
+        var provider = new Provider();
+        var service = new ConversationService(store, provider, clock)
+        {
+            ContextEnvironment = _ => selected ? game : null,
+            StatusEnvironment = _ => null, ChatVoiceEnvironment = _ => null,
+        };
+        var memory = service.Memory;
+        memory.Note(game, "fixture-bot", "A supplied earlier observation", Start.AddSeconds(-1));
+        var observed = new[]
+        {
+            "PlayerFixture: an earlier question",
+            "Fixture: a supplied observed line",
+            "PlayerFixture: the same intentional line",
+            "PlayerFixture: the same intentional line",
+        };
+        var e = new ConversationEvent
+        {
+            GameId = game, ServerInstanceId = "synthetic-instance",
+            Bot = new ConversationHearer { ActorKey = "fixture-bot", DisplayName = "Fixture" },
+            Kind = "loot", Detail = "found a smooth stone", Channel = "party", Place = "Synthetic Meadow",
+            NearbyPlayers = ["PlayerFixture"], RecentLines = observed, OccurredAtUtc = Start,
+        };
+
+        var first = await service.EventAsync(e, default);
+        Assert.Equal("nice find", first.Text);
+        Assert.Single(provider.Requests);
+        // The supplied event is fixture evidence; no speech publication or receipt occurs.
+        const string eventMemory = "I found a smooth stone in Synthetic Meadow with PlayerFixture there";
+        var journal = memory.Get(game, "fixture-bot")!.Journal;
+        Assert.Equal(2, journal.Count);
+        Assert.Contains(journal, entry => entry.Text == "A supplied earlier observation");
+        Assert.Equal(selected ? eventMemory : eventMemory + "; I said \"nice find\"", journal.Last().Text);
+
+        clock.Now = Start.AddSeconds(31);
+        var channel = game == "ffxi" ? "linkshell" : "general";
+        var second = await service.EventAsync(e with
+        {
+            Kind = "channel_" + channel, Channel = channel, Detail = "asking about an outing",
+            OccurredAtUtc = clock.Now,
+        }, default);
+        Assert.Equal("anyone exploring?", second.Text);
+        Assert.Equal(2, provider.Requests.Count);
+        Assert.Equal(2, service.Events);
+        var next = provider.Requests[1];
+        Assert.Contains(next.RelevantMemories, text => text.Contains("A supplied earlier observation", StringComparison.Ordinal));
+        Assert.Contains(next.RelevantMemories, text => text.Contains(eventMemory, StringComparison.Ordinal));
+        Assert.Equal(!selected, next.RelevantMemories.Any(text => text.Contains("I said \"nice find\"", StringComparison.Ordinal)));
+        if (selected)
+        {
+            Assert.Equal(observed, next.ConversationContext!.History);
+            Assert.Null(next.ConversationContext.CurrentMessage);
+            Assert.DoesNotContain("nice find", DialogueWordingPromptText.Build(next, game).UserMessage);
+        }
+        else Assert.Null(next.ConversationContext);
+
+        // A channel-start intent has no observed event to add to the selected journal.
+        journal = memory.Get(game, "fixture-bot")!.Journal;
+        Assert.Equal(selected ? 2 : 3, journal.Count);
+        Assert.Contains(journal, entry => entry.Text == "A supplied earlier observation");
+        Assert.Equal(!selected, journal.Any(entry => entry.Text.Contains("I said in " + channel + " chat \"anyone exploring?\"", StringComparison.Ordinal)));
+    }
+}
diff --git a/tests/Dit.HumanBehavior.Neuronetwork.Tests/PreparedHeardMemoryTests.cs b/tests/Dit.HumanBehavior.Neuronetwork.Tests/PreparedHeardMemoryTests.cs
new file mode 100644
index 00000000..70d3a367
--- /dev/null
+++ b/tests/Dit.HumanBehavior.Neuronetwork.Tests/PreparedHeardMemoryTests.cs
@@ -0,0 +1,120 @@
+using Dit.HumanBehavior.DialogueWording;
+using Dit.HumanBehavior.Neuronetwork.Conversation;
+using Dit.HumanBehavior.Neuronetwork.Social;
+using Dit.HumanBehavior.Neuronetwork.Store;
+using Xunit;
+
+namespace Dit.HumanBehavior.Neuronetwork.Tests;
+
+public sealed class PreparedHeardMemoryTests
+{
+    private static readonly DateTimeOffset Start = new(2030, 1, 1, 0, 0, 0, TimeSpan.Zero);
+
+    private sealed class Clock : TimeProvider
+    {
+        public DateTimeOffset Now = Start;
+        public override DateTimeOffset GetUtcNow() => Now;
+    }
+
+    private sealed class Provider : IDialogueWordingProvider
+    {
+        public readonly List<DialogueWordingRequest> Requests = [];
+        public string ProviderName => "synthetic-prepared-heard-memory";
+        public Task<DialogueWordingResult> GenerateAsync(DialogueWordingRequest request, CancellationToken token)
+        {
+            Requests.Add(request);
+            return Task.FromResult(new DialogueWordingResult(request.RequestId, ProviderName, "fake",
+                Requests.Count == 1 ? "sounds fun" : "maybe tomorrow",
+                DialogueWordingCompletionStatus.Succeeded, TimeSpan.Zero, null, null, true,
+                DialogueProviderFailureClassification.None, request.GenerationPolicyVersion));
+        }
+    }
+
+    [Theory]
+    [InlineData("ffxi", true)] [InlineData("swtor", true)]
+    [InlineData("ffxi", false)] [InlineData("swtor", false)]
+    public async Task Prepared_heard_reply_preserves_input_without_spoken_memory_or_exchange_credit(string game, bool selected)
+    {
+        using var store = new NeuronetworkStore(":memory:");
+        var clock = new Clock();
+        var provider = new Provider();
+        // No envelope ingestor: relationship assertions isolate Finish from the independent incoming-chat feed.
+        var service = new ConversationService(store, provider, clock)
+        {
+            ContextEnvironment = _ => selected ? game : null,
+            StatusEnvironment = _ => null, ChatVoiceEnvironment = _ => null,
+            QuickReplies = false, KnowledgeAnswers = false,
+        };
+        var memory = service.Memory;
+        memory.Note(game, "fixture-bot", "A supplied earlier observation", Start.AddSeconds(-1));
+        var relationships = new Relationships(store);
+        relationships.Apply([new(game, "Fixture", "PlayerFixture", RelationshipKinds.HelpedInFight,
+            "A supplied earlier relationship observation", Start.AddSeconds(-1))], Start);
+        var observed = new[]
+        {
+            "PlayerFixture: an earlier question",
+            "Fixture: a supplied observed line",
+            "PlayerFixture: the same intentional line",
+            "PlayerFixture: the same intentional line",
+        };
+        var heard = new ConversationHeard
+        {
+            GameId = game, ServerInstanceId = "synthetic-instance", LineId = "synthetic-first",
+            Channel = "party", Speaker = new ConversationSpeaker("PlayerFixture", true),
+            Text = "anyone exploring tonight?", Place = "Synthetic Meadow", OccurredAtUtc = Start,
+            Hearers = [new ConversationHearer { ActorKey = "fixture-bot", DisplayName = "Fixture", Addressed = true, InPartyWithSpeaker = true }],
+            History = observed,
+        };
+
+        var first = Assert.Single((await service.ReplyAsync(heard, default)).Decisions);
+        Assert.Equal("say", first.Kind);
+        Assert.Equal("sounds fun", first.Text);
+        Assert.Single(provider.Requests);
+        // The incoming line is fixture evidence; neither prepared reply is published or confirmed.
+        const string heardMemory = "PlayerFixture said \"anyone exploring tonight?\" in Synthetic Meadow";
+        var journal = memory.Get(game, "fixture-bot")!.Journal;
+        Assert.Equal(2, journal.Count);
+        Assert.Contains(journal, entry => entry.Text == "A supplied earlier observation");
+        Assert.Equal(selected ? heardMemory : heardMemory + "; I said \"sounds fun\"", journal.Last().Text);
+        var standing = relationships.Standing(game, "Fixture", "PlayerFixture")!;
+        Assert.Equal(1, standing.Counts[RelationshipKinds.HelpedInFight]);
+        Assert.Equal(selected ? 1 : 2, standing.Events);
+        Assert.Equal(selected ? 0 : 1, standing.Counts.GetValueOrDefault(RelationshipKinds.Chatted));
+
+        // Prepared decisions still reserve the line; duplicate input does not generate or book a second reply.
+        Assert.Equal("silence", Assert.Single((await service.ReplyAsync(heard, default)).Decisions).Kind);
+        Assert.Single(provider.Requests);
+        Assert.Equal(2, memory.Get(game, "fixture-bot")!.Journal.Count);
+        Assert.Equal(standing.Events, relationships.Standing(game, "Fixture", "PlayerFixture")!.Events);
+
+        clock.Now = Start.AddSeconds(31); // Within the focus window: legacy mode credits an answer to the bot.
+        var second = await service.ReplyAsync(heard with
+        {
+            LineId = "synthetic-second", Text = "what about tomorrow?", OccurredAtUtc = clock.Now,
+        }, default);
+        var secondDecision = Assert.Single(second.Decisions);
+        Assert.Equal("say", secondDecision.Kind);
+        Assert.Equal("maybe tomorrow", secondDecision.Text);
+        Assert.Equal(2, provider.Requests.Count);
+        var next = provider.Requests[1];
+        Assert.Contains(next.RelevantMemories, text => text.Contains("A supplied earlier observation", StringComparison.Ordinal));
+        Assert.Contains(next.RelevantMemories, text => text.Contains(heardMemory, StringComparison.Ordinal));
+        Assert.Equal(!selected, next.RelevantMemories.Any(text => text.Contains("I said \"sounds fun\"", StringComparison.Ordinal)));
+        if (selected)
+        {
+            Assert.Equal(observed, next.ConversationContext!.History);
+            Assert.Equal("what about tomorrow?", next.ConversationContext.CurrentMessage);
+            Assert.DoesNotContain("sounds fun", DialogueWordingPromptText.Build(next, game).UserMessage);
+        }
+        else Assert.Null(next.ConversationContext);
+
+        journal = memory.Get(game, "fixture-bot")!.Journal;
+        Assert.Equal(3, journal.Count);
+        Assert.Contains(journal, entry => entry.Text.StartsWith("PlayerFixture said \"what about tomorrow?\"", StringComparison.Ordinal));
+        Assert.Equal(!selected, journal.Any(entry => entry.Text.Contains("I said \"maybe tomorrow\"", StringComparison.Ordinal)));
+        standing = relationships.Standing(game, "Fixture", "PlayerFixture")!;
+        Assert.Equal(1, standing.Counts[RelationshipKinds.HelpedInFight]);
+        Assert.Equal(selected ? 1 : 3, standing.Events);
+        Assert.Equal(selected ? 0 : 1, standing.Counts.GetValueOrDefault(RelationshipKinds.AnsweredBot));
+    }
+}
